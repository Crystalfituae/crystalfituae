---
// Home page
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import LineIcon from '../components/LineIcon.astro';
import Icon from '../components/Icon.astro';
import data from '../data/home-faq.json';
import Masonry from '../components/Masonry.astro';
import '../styles/portfolio.css';
import '../styles/pages.css';
import heroImg from '../assets/site/home-1.jpg';
import l1 from '../assets/home/latest-1.jpg';
import l2 from '../assets/home/latest-2.jpg';
import l3 from '../assets/home/latest-3.jpg';
import l4 from '../assets/home/latest-4.jpg';
import l5 from '../assets/home/latest-5.jpg';
import l6 from '../assets/home/latest-6.jpg';
import l7 from '../assets/home/latest-7.jpg';

const all = await getCollection('projects', ({ data }) => !data.draft);
const cover = (id: string) => all.find((p) => p.id === id)!.data.cover;
// What we do: [title, short line, anchor on /services/]
const services: [string, string, string][] = [
  ['F&B Design & Build', 'Cafes, coffee shops & restaurants', '/services/#fnb'],
  ['Commercial Fit-outs', 'Offices, clinics, retail & galleries', '/services/#commercial'],
  ['Residential Interiors', 'Villas, townhouses & apartments', '/services/#residential'],
  ['Design & Tech. Consultancy', 'Concepts, drawings & approvals', '/services/#consultancy'],
  ['Project Management', 'Programme, budget & quality on site', '/services/#project-management'],
];
const stats: [string, string][] = [['2014', 'UAE grown since'], ['200+', 'Projects handed over'], ['90 days', 'Shell & core to opening'], ['100%', 'Approvals in‑house']];
const logos = import.meta.glob<{ default: ImageMetadata }>('../assets/logos/*', { eager: true });
const lg = (n: string) => Object.entries(logos).find(([k]) => k.endsWith('/' + n))![1].default;
const approved: [string, string][] = [['emaar-logo-1.png', 'Emaar'], ['aw-dh-pv-pos-rgb-en-002.png', 'Dubai Holding'], ['tecom-group.png', 'TECOM'], ['nakheel-properties-logo-2.png', 'Nakheel'], ['dub-gov-300.png', 'Government of Dubai'], ['trakhees.png', 'Trakhees'], ['dubai-civil-defense.png', 'Dubai Civil Defense'], ['dewa.png', 'DEWA'], ['vindico.png', 'Vindico'], ['1621791093880-1.png', 'IDAMA']];
const latestBig = [
  { img: l1, span: 2, title: 'WALA Coffee & Roastery', sub: 'Al Quoz, Dubai, UAE', slug: 'wala-coffee-roastery' },
  { img: l2, span: 1, title: 'Panmi Cafe', sub: 'Dubai Hills, Dubai', slug: 'panmi-coffee-shop-dubai-hills' },
  { img: l3, span: 2, title: 'Gari Tatintsian Gallery', sub: 'Dubai Design District', slug: 'gary-tatintsian-gallery' },
  { img: l4, span: 2, title: 'Roasters Specialty Coffee', sub: 'Dubai Hills', slug: 'roasters-dubai-hills' },
  { img: l5, span: 2, title: 'YOY Neo Bistro Restaurant', sub: 'Shangri-La Hotel, Sheikh Zayed Rd, Dubai, UAE', slug: 'restaurant-contractor-dubai-yoy-neo-bistro' },
  { img: l6, span: 2, title: 'Self.Space Studio', sub: 'Ghoshi City, Al Quoz, Dubai', slug: 'self-space-studio-dubai' },
  { img: l7, span: 1, title: 'AMV Aesthetic Clinic', sub: 'Bay Square, Dubai', slug: 'amv-aesthetic-clinic' },
];
const faq = data as [string, string][];
const faqSchema = [{ '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) }];
---
<Base schema={faqSchema} title="Crystal Fit – Cafe, Restaurant & Office Fit-Out in Dubai" description="Design & build fit-out contractor in Dubai since 2014: 200+ cafes, restaurants, offices and villas. Approved by Emaar, Dubai Holding, TECOM & Nakheel.">

  <!-- 1. Hero: what we do, in one sentence -->
  <section class="hd-hero">
    <Image src={heroImg} alt="YOY Neo Bistro restaurant fit-out by Crystal Fit" class="hd-hero__img" widths={[480, 800, 1080, 1440, 1920]} sizes="100vw" loading="eager" fetchpriority="high" quality={72} />
    <div class="hd-hero__content">
      <h1>Design &amp; Build<br />Fit-Out in Dubai<span class="sr-only"> — Crystal Fit Contracting LLC</span></h1>
      <div class="hd-hero__btns"><a class="hd-btn hd-btn--white" href="/portfolio/">View portfolio</a><a class="hd-btn hd-btn--line" href="#contact-form">Get a quote</a></div>
    </div>
  </section>

  <!-- 2. Numbers -->
  <section class="hd-stats">{stats.map(([n, t]) => { const [num, ...unit] = n.split(' '); return <div><b>{num}{unit.length > 0 && <small> {unit.join(' ')}</small>}</b><span>{t}</span></div>; })}</section>





  <!-- 7. Latest projects: same large masonry layout as the current home page -->
  <section class="latest latest--dark">
    <h2 class="latest__title">LATEST Projects</h2>
    <Masonry id="latest" class="latest__grid">
      {latestBig.map((x) => (
        <article class="pcard" data-span={x.span} data-span-2="1">
          <a href={`/featured-projects/${x.slug}/`} class="pcard__media" style={`aspect-ratio:${x.img.width}/${x.img.height}`}>
            <Image src={x.img} alt={x.title} widths={[360, 480, 640, 800, 1080, 1320]} sizes={x.span === 2 ? '(min-width: 768px) 50vw, 100vw' : '(min-width: 992px) 25vw, (min-width: 768px) 50vw, 100vw'} loading="lazy" />
            <span class="pcard__plus" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg></span>
          </a>
          <div class="pcard__body">
            <h6 class="pcard__title"><a href={`/featured-projects/${x.slug}/`}>{x.title}</a></h6>
            <div class="pcard__sub">{x.sub}</div>
          </div>
        </article>
      ))}
    </Masonry>
    <div class="latest__btn"><a class="btn btn--black" href="/portfolio/">View portfolio</a></div>
  </section>

  <!-- 6. Approvals as logos -->
  <section class="hd-approved">
    <h2 class="hd-h2">We deliver to the standards of</h2>
    <div class="hd-approved__vp"><ul>{[...approved, ...approved].map(([f, n], i) => <li aria-hidden={i >= approved.length ? 'true' : undefined} class:list={{ 'hd-dup': i >= approved.length, 'hd-noinv': f.startsWith('emaar'), 'hd-white': f === 'dewa.png' || f === 'dubai-civil-defense.png', 'hd-wide': f === 'dewa.png' || f === 'dubai-civil-defense.png' }}><Image src={lg(f)} alt={i >= approved.length ? '' : `${n} logo`} widths={[160, 320]} sizes="160px" loading="lazy" /></li>)}</ul></div>
  </section>


  <!-- 3. What we do: clickable numbered list -> sections of /services/ -->
  <section class="hd-dark"><div class="hd-sec hd-sec--wide">
    <h2 class="hd-h2 hd-h2--big">What we do<span class="dot" aria-hidden="true"></span></h2>
    <ol class="hd-list">
      {services.map(([t, d, href], i) => <li><a href={href}><em>0{i + 1}</em><b>{t}</b><span>{d}</span><i aria-hidden="true">→</i></a></li>)}
    </ol>
  </div></section>

  <!-- FAQ: same style as the original home page -->
  <section class="faq">
    <h2 class="faq__title">FAQ</h2>
    <div class="faq__list">
      {faq.map(([q, a]) => (
        <details class="faq__item">
          <summary><span>{q}</span><Icon name="caret-right" size={10} class="faq__icon" /></summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </section>
</Base>
<style is:global>
  .hd-hero { position: relative; height: 720px; overflow: hidden; background: #111; }
  .hd-hero__img { width: 100%; height: 100%; object-fit: cover; }
  .hd-hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(0,0,0,.72) 0%, rgba(0,0,0,.35) 50%, rgba(0,0,0,0) 80%); }
  .hd-hero__content { position: absolute; z-index: 1; left: 60px; top: 50%; transform: translateY(-50%); max-width: 600px; color: #fff; font-family: var(--ff-head); }
  .hd-hero h1 { font-family: var(--ff-head); font-size: var(--fs-h1); line-height: var(--lh-h1); font-weight: 400; letter-spacing: 4px; text-transform: uppercase; margin: 0 0 22px; }
  .hd-hero p { font-family: var(--ff-head); font-size: var(--fs-lead); line-height: var(--lh-lead); font-weight: 400; letter-spacing: 0; margin: 0 0 32px; }
  .hd-hero__btns { display: flex; gap: 14px; flex-wrap: wrap; }
  .hd-btn { font-family: var(--ff-head); font-size: var(--fs-btn); line-height: var(--lh-btn); font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; display: inline-block; padding: 15px 30px; }
  .hd-btn--white { background: #fff; color: #000; }
  .hd-btn--line { border: 1px solid #fff; color: #fff; }
  .hd-stats { display: grid; grid-template-columns: repeat(4, 1fr); max-width: 1180px; margin: 0 auto; padding: 64px 40px; font-family: var(--ff-head); text-align: center; }
  .hd-stats b { font-family: var(--ff-head); font-size: var(--fs-stat); line-height: var(--lh-stat); font-weight: 700; letter-spacing: 1px; font-variant-numeric: lining-nums; display: block; color: #000; margin-bottom: 12px; }
  .hd-stats b small { font-size: .42em; line-height: 0; text-transform: uppercase; font-weight: 700; letter-spacing: 1px; } /* keep the line box of "90 days" equal to the others */
  .hd-stats span { font-family: var(--ff-head); font-size: var(--fs-body); line-height: var(--lh-body); font-weight: 400; letter-spacing: 0; text-transform: none; display: block; color: #333; }
  .hd-sec { max-width: 1260px; margin: 0 auto; padding: 70px 40px; font-family: var(--ff-head); }
  .hd-grey { max-width: none; background: #f4f4f4; }
  .hd-grey > * { max-width: 1180px; margin-left: auto; margin-right: auto; }
  .hd-h2 { font-family: var(--ff-head); font-size: var(--fs-h2); line-height: var(--lh-h2); font-weight: 200; letter-spacing: 0; text-transform: uppercase; margin-top: 0; margin-bottom: 34px; }
  .hd-head { display: flex; justify-content: space-between; align-items: baseline; }
  .hd-more { font-family: var(--ff-head); font-size: var(--fs-label); line-height: var(--lh-label); font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: #000; }
  .hd-dark { background: #000; color: #fff; }
  .hd-dark .hd-h2 { color: #fff; }
  .hd-h2--big { font-family: var(--ff-head); font-size: var(--fs-h2); line-height: var(--lh-h2); font-weight: 200; letter-spacing: 0; text-transform: uppercase; }
  .hd-dark .hd-more { color: #fff; }
  .hd-sec--wide { max-width: 1360px; }
  /* What we do: numbered list (variant B) */
  .hd-list { list-style: none; padding: 0; margin: 0; border-top: 1px solid #333; }
  .hd-list a { display: grid; grid-template-columns: 60px 1fr 1fr 30px; align-items: center; gap: 20px; padding: 20px 4px; border-bottom: 1px solid #333; color: #fff; transition: padding .2s, background .2s; }
  .hd-list a:hover { background: #111; padding-left: 14px; }
  .hd-list em { font-family: var(--ff-head); font-size: var(--fs-label); line-height: var(--lh-label); font-weight: 700; letter-spacing: 2px; text-transform: uppercase; font-style: normal; color: #777; }
  .hd-list b { font-family: var(--ff-head); font-size: var(--fs-h3); line-height: var(--lh-h3); font-weight: 500; letter-spacing: 1px; text-transform: uppercase; }
  .hd-list span { font-family: var(--ff-head); font-size: var(--fs-body); line-height: var(--lh-body); font-weight: 300; letter-spacing: 0; color: #bbb; }
  .hd-list i { font-style: normal; font-size: 20px; text-align: right; }
  @media (max-width: 991px) {
    .hd-list a { grid-template-columns: 36px 1fr 24px; gap: 4px 12px; }
    .hd-list span { grid-column: 2; grid-row: 2; }

    .hd-list i { grid-column: 3; grid-row: 1 / span 2; }
  }
  .hd-ticker { overflow: hidden; background: #000; color: #fff; padding: 22px 0; font-family: var(--ff-head); }
  .hd-ticker__track { display: flex; gap: 0; width: max-content; animation: hd-tick 40s linear infinite; }
  .hd-ticker span { font-size: 26px; font-weight: 300; letter-spacing: 3px; text-transform: uppercase; white-space: nowrap; }
  .hd-ticker span::after { content: '•'; margin: 0 34px; color: #777; }
  @keyframes hd-tick { to { transform: translateX(-50%); } }
  @keyframes hd-logos { to { transform: translateX(calc(-50% - var(--lg-gap) / 2)); } }
  @media (prefers-reduced-motion: reduce) { .hd-ticker__track, .hd-approved ul { animation: none !important; } }
  .hd-steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(5, 1fr); position: relative; }
  .hd-steps::before { content: ''; position: absolute; left: 10%; right: 10%; top: 32px; border-top: 1px dashed #bbb; }
  .hd-steps li { position: relative; text-align: center; padding: 0 10px; }
  .hd-steps__ico { position: relative; display: inline-flex; width: 64px; height: 64px; align-items: center; justify-content: center; border: 1px solid #222; border-radius: 50%; background: #fff; }
  .hd-steps b { display: block; margin-top: 14px; font-size: 13px; color: #999; letter-spacing: 2px; }
  .hd-steps h3 { font-family: var(--ff-head); font-size: var(--fs-h3); line-height: var(--lh-h3); font-weight: 500; letter-spacing: 1px; text-transform: uppercase; margin: 4px 0 4px; }
  .hd-steps p { font-size: var(--fs-small); line-height: var(--lh-small); color: #555; margin: 0; }
  .hd-approved { --lg-gap: 80px; text-align: center; padding: 70px 0; background: #fff; color: var(--dark); font-family: var(--ff-head); }
  .hd-approved__vp { background: #fff; overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .hd-approved ul { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: var(--lg-gap); width: max-content; background: #fff; animation: hd-logos 50s linear infinite; }
  .hd-approved ul:hover { animation-play-state: paused; }
  .hd-approved li { flex: 0 0 auto; width: 150px; height: 150px; display: flex; align-items: center; justify-content: center; } /* same 150x150 frame as client logos */
  .hd-approved img { max-width: 100%; max-height: 100%; width: auto; height: auto; margin: 0 auto; display: block; filter: grayscale(1) contrast(1.1); mix-blend-mode: multiply; opacity: .85; }
  .hd-approved .hd-h2 { color: var(--dark); padding: 0 16px; }
  .hd-approved .hd-white img { filter: brightness(0) invert(.25); mix-blend-mode: normal; }
  .latest--dark { background: #000; padding-top: 70px; padding-bottom: 80px; }
  .latest--dark .latest__title, .latest--dark .pcard__title, .latest--dark .pcard__title a { color: #fff; }
  .latest--dark .pcard__sub { color: #cfcfcf; }
  .latest--dark .pcard__media { background: #111; }
  .latest--dark .btn--black { background: #fff; color: #000; }
  .hd-approved p { font-size: var(--fs-small); line-height: var(--lh-small); margin: 30px 0 0; color: #555; }
  .hd-proj { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px 22px; }
  .hd-proj a { color: #000; }
  .hd-proj img { width: 100%; height: auto; aspect-ratio: 4/3; object-fit: cover; display: block; }
  .hd-proj h3 { font-family: var(--ff-head); font-size: var(--fs-card); line-height: var(--lh-card); font-weight: 600; letter-spacing: 1px; text-transform: uppercase; margin: 14px 0 2px; }
  .hd-proj span { font-size: 14px; color: #c0392b; }
  .hd-quotes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .hd-quotes figure { margin: 0; background: #fff; padding: 28px; }
  .hd-quotes blockquote { margin: 0 0 18px; font-size: 16px; line-height: 26px; font-style: italic; color: #333; }
  .hd-quotes b { display: block; font-size: 14px; text-transform: uppercase; letter-spacing: 1px; }
  .hd-quotes span { font-size: 13px; color: #777; }
  .hd-faq details { border-bottom: 1px solid #ddd; padding: 16px 0; }
  .hd-faq summary { font-family: var(--ff-head); font-size: var(--fs-q); line-height: var(--lh-q); font-weight: 500; letter-spacing: 0; cursor: pointer; list-style: none; }
  .hd-faq summary::after { content: '+'; float: right; font-weight: 300; }
  .hd-faq details[open] summary::after { content: '–'; }
  .hd-faq p { font-family: var(--ff-head); font-size: var(--fs-body); line-height: var(--lh-body); font-weight: 300; letter-spacing: 0; color: #444; margin: 12px 0 0; }
  @media (max-width: 991px) {
    .hd-hero { height: 600px; }
    .hd-hero__content { left: 20px; right: 20px; top: auto; bottom: 90px; transform: none; }

    .hd-hero p { margin-bottom: 22px; }
    .hd-hero::after { background: linear-gradient(0deg, rgba(0,0,0,.8) 0%, rgba(0,0,0,.3) 60%, rgba(0,0,0,.1) 100%); }
    .hd-stats { grid-template-columns: repeat(2, 1fr); gap: 10px; padding: 40px 16px; }
    .hd-stats b { margin-bottom: 6px; }

    .hd-stats > div:nth-child(n+3) { display: none; }
    .hd-sec { padding: 46px 16px; }
    .hd-h2 { margin-bottom: 24px; }

    .hd-ticker span { font-size: 18px; }
    .hd-steps { grid-template-columns: 1fr; gap: 22px; }
    .hd-steps::before { left: 32px; right: auto; top: 10px; bottom: 10px; border-top: 0; border-left: 1px dashed #bbb; }
    .hd-steps li { display: grid; grid-template-columns: 64px 1fr; column-gap: 18px; text-align: left; padding: 0; align-items: center; }
    .hd-steps__ico { grid-row: span 3; }
    .hd-steps b { margin: 0; }
    .hd-approved { --lg-gap: 40px; padding: 44px 0; }
    .hd-approved ul { animation-duration: 36s; }
    .hd-proj { grid-template-columns: repeat(2, 1fr); gap: 20px 12px; }
    .hd-quotes { grid-template-columns: 1fr; }
  }
  @media (max-width: 599px) { .hd-proj { grid-template-columns: 1fr; } }
</style>
