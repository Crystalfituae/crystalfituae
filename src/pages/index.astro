---
// Home page
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import LineIcon from '../components/LineIcon.astro';
import Icon from '../components/Icon.astro';
import data from '../data/home-faq.json';
import Masonry from '../components/Masonry.astro';
import '../styles/portfolio.css';
import '../styles/pages.css';
import heroImg from '../assets/site/home-1.jpg';
import l1 from '../assets/home/latest-1.jpg';
import l2 from '../assets/home/latest-2.jpg';
import l3 from '../assets/home/latest-3.jpg';
import l4 from '../assets/home/latest-4.jpg';
import l5 from '../assets/home/latest-5.jpg';
import l6 from '../assets/home/latest-6.jpg';
import render from '../assets/services/design-render-omakase.jpg';
import l7 from '../assets/home/latest-7.jpg';

const all = await getCollection('projects', ({ data }) => !data.draft);
const cover = (id: string) => all.find((p) => p.id === id)!.data.cover;
const services: [string, string, string, ImageMetadata, string][] = [
  ['Food & Beverage (F&B)', 'Cafes, coffee shops and restaurants — designed and built to open on time.', '/cafe-restaurant-fit-out-dubai/', cover('roasters-dubai-hills'), 'chat'],
  ['Commercial', 'Offices, clinics and retail spaces that work for your business.', '/commercial-fit-out-dubai/', cover('gary-tatintsian-gallery'), 'layers'],
  ['Residential', 'Villas, penthouses and apartments, from design to move-in.', '/villa-interior-design-dubai/', cover('anantara-penthouse'), 'pin'],
  ['Design & Consultancy', 'Concepts, 3D, technical drawings and approvals management.', '/interior-design-consultancy-dubai/', render, 'pen'],
];
const stats: [string, string][] = [['2014', 'UAE grown since'], ['200+', 'Projects handed over'], ['1', 'Team from design to handover'], ['1 year', 'Warranty on works']];
const logos = import.meta.glob<{ default: ImageMetadata }>('../assets/logos/*', { eager: true });
const lg = (n: string) => Object.entries(logos).find(([k]) => k.endsWith('/' + n))![1].default;
const approved: [string, string][] = [['emaar-logo-1.png', 'Emaar'], ['aw-dh-pv-pos-rgb-en-002.png', 'Dubai Holding'], ['tecom-group.png', 'TECOM'], ['nakheel-properties-logo-2.png', 'Nakheel'], ['dub-gov-300.png', 'Government of Dubai'], ['trakhees.png', 'Trakhees']];
const latestBig = [
  { img: l1, span: 2, title: 'WALA Coffee & Roastery', sub: 'Al Quoz, Dubai, UAE', slug: 'wala-coffee-roastery' },
  { img: l2, span: 1, title: 'Panmi Cafe', sub: 'Dubai Hills, Dubai', slug: 'panmi-coffee-shop-dubai-hills' },
  { img: l3, span: 2, title: 'Gari Tatintsian Gallery', sub: 'Dubai Design District', slug: 'gary-tatintsian-gallery' },
  { img: l4, span: 2, title: 'Roasters Specialty Coffee', sub: 'Dubai Hills', slug: 'roasters-dubai-hills' },
  { img: l5, span: 2, title: 'YOY Neo Bistro Restaurant', sub: 'Shangri-La Hotel, Sheikh Zayed Rd, Dubai, UAE', slug: 'restaurant-contractor-dubai-yoy-neo-bistro' },
  { img: l6, span: 2, title: 'Self.Space Studio', sub: 'Ghoshi City, Al Quoz, Dubai', slug: 'self-space-studio-dubai' },
  { img: l7, span: 1, title: 'AMV Aesthetic Clinic', sub: 'Bay Square, Dubai', slug: 'amv-aesthetic-clinic' },
];
const faq = (data as [string, string][]).slice(0, 6);
const faqSchema = [{ '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) }];
---
<Base schema={faqSchema} title="Crystal Fit – Cafe, Restaurant & Office Fit-Out in Dubai" description="Design & build fit-out contractor in Dubai since 2014: 200+ cafes, restaurants, offices and villas. Approved by Emaar, Dubai Holding, TECOM & Nakheel.">

  <!-- 1. Hero: what we do, in one sentence -->
  <section class="hd-hero">
    <Image src={heroImg} alt="YOY Neo Bistro restaurant fit-out by Crystal Fit" class="hd-hero__img" widths={[480, 800, 1080, 1440, 1920]} sizes="100vw" loading="eager" fetchpriority="high" quality={72} />
    <div class="hd-hero__content">
      <h1>Design &amp; Build<br />Fit-Out in Dubai<span class="sr-only"> — Crystal Fit Contracting LLC</span></h1>
      <div class="hd-hero__btns"><a class="hd-btn hd-btn--white" href="/portfolio/">View portfolio</a><a class="hd-btn hd-btn--line" href="#contact-form">Get a quote</a></div>
    </div>
  </section>

  <!-- 2. Numbers -->
  <section class="hd-stats">{stats.map(([n, t]) => <div><b>{n}</b><span>{t}</span></div>)}</section>




  <!-- 6. Approvals as logos -->
  <section class="hd-approved">
    <h2 class="hd-h2">We deliver to the standards of</h2>
    <div class="hd-approved__vp"><ul>{[...approved, ...approved].map(([f, n], i) => <li aria-hidden={i >= approved.length ? 'true' : undefined} class:list={{ 'hd-dup': i >= approved.length }}><Image src={lg(f)} alt={i >= approved.length ? '' : `${n} logo`} widths={[160, 320]} sizes="160px" loading="lazy" /></li>)}</ul></div>
  </section>

  <!-- 7. Latest projects: same large masonry layout as the current home page -->
  <section class="latest">
    <h2 class="latest__title">LATEST Projects</h2>
    <Masonry id="latest" class="latest__grid">
      {latestBig.map((x) => (
        <article class="pcard" data-span={x.span} data-span-2="1">
          <a href={`/featured-projects/${x.slug}/`} class="pcard__media" style={`aspect-ratio:${x.img.width}/${x.img.height}`}>
            <Image src={x.img} alt={x.title} widths={[360, 480, 640, 800, 1080, 1320]} sizes={x.span === 2 ? '(min-width: 768px) 50vw, 100vw' : '(min-width: 992px) 25vw, (min-width: 768px) 50vw, 100vw'} loading="lazy" />
            <span class="pcard__plus" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg></span>
          </a>
          <div class="pcard__body">
            <h6 class="pcard__title"><a href={`/featured-projects/${x.slug}/`}>{x.title}</a></h6>
            <div class="pcard__sub">{x.sub}</div>
          </div>
        </article>
      ))}
    </Masonry>
    <div class="latest__btn"><a class="btn btn--black" href="/portfolio/">View portfolio</a></div>
  </section>


  <!-- 3. Services: 4 cards -->
  <section class="hd-dark"><div class="hd-sec">
    <h2 class="hd-h2 hd-h2--big">What we do<span class="dot" aria-hidden="true"></span></h2>
    <div class="hd-svc">
      {services.map(([t, d, href, img, ico]) => (
        <a class="hd-svc__card" href={href}>
          <Image src={img} alt={t} width={600} height={420} widths={[320, 600]} sizes="(min-width: 992px) 25vw, (min-width: 600px) 50vw, 100vw" fit="cover" loading="lazy" quality={70} />
          <div class="hd-svc__body"><h3>{t}</h3><p>{d}</p><span class="hd-more">Learn more →</span></div>
        </a>
      ))}
    </div>
  </div></section>

  <!-- FAQ: same style as the original home page -->
  <section class="faq">
    <h2 class="faq__title">FAQ</h2>
    <div class="faq__list">
      {faq.map(([q, a]) => (
        <details class="faq__item">
          <summary><span>{q}</span><Icon name="caret-right" size={10} class="faq__icon" /></summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </section>
</Base>
<style is:global>
  .hd-hero { position: relative; height: 720px; overflow: hidden; background: #111; }
  .hd-hero__img { width: 100%; height: 100%; object-fit: cover; }
  .hd-hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(0,0,0,.72) 0%, rgba(0,0,0,.35) 50%, rgba(0,0,0,0) 80%); }
  .hd-hero__content { position: absolute; z-index: 1; left: 60px; top: 50%; transform: translateY(-50%); max-width: 600px; color: #fff; font-family: var(--ff-head); }
  .hd-hero h1 { font-size: 58px; line-height: 66px; font-weight: 400; letter-spacing: 4px; text-transform: uppercase; margin: 0 0 22px; }
  .hd-hero p { font-size: 20px; line-height: 31px; font-weight: 300; margin: 0 0 32px; }
  .hd-hero__btns { display: flex; gap: 14px; flex-wrap: wrap; }
  .hd-btn { display: inline-block; padding: 15px 30px; font-size: 13px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; }
  .hd-btn--white { background: #fff; color: #000; }
  .hd-btn--line { border: 1px solid #fff; color: #fff; }
  .hd-stats { display: grid; grid-template-columns: repeat(4, 1fr); max-width: 1180px; margin: 0 auto; padding: 46px 40px; font-family: var(--ff-head); text-align: center; border-bottom: 1px solid #eee; }
  .hd-stats b { display: block; font-size: 46px; line-height: 1.1; font-weight: 300; }
  .hd-stats span { display: block; font-size: 13px; letter-spacing: 1.5px; text-transform: uppercase; color: #666; }
  .hd-sec { max-width: 1260px; margin: 0 auto; padding: 70px 40px; font-family: var(--ff-head); }
  .hd-grey { max-width: none; background: #f4f4f4; }
  .hd-grey > * { max-width: 1180px; margin-left: auto; margin-right: auto; }
  .hd-h2 { font-family: var(--ff-head); font-size: 32px; line-height: 1.2; font-weight: 400; letter-spacing: 2px; text-transform: uppercase; margin-top: 0; margin-bottom: 34px; }
  .hd-head { display: flex; justify-content: space-between; align-items: baseline; }
  .hd-more { font-size: 13px; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; color: #000; }
  .hd-dark { background: #000; color: #fff; }
  .hd-dark .hd-h2 { color: #fff; }
  .hd-h2--big { font-size: 43px; line-height: 60px; font-weight: 400; letter-spacing: 0; }
  .hd-dark .hd-svc__card { background: #111; border-color: #222; color: #fff; }
  .hd-dark .hd-svc__card:hover { box-shadow: 0 12px 30px rgba(255,255,255,.06); }
  .hd-dark .hd-svc__body p { color: #bdbdbd; }
  .hd-dark .hd-more { color: #fff; }
  .hd-svc { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; }
  .hd-svc__card { display: flex; flex-direction: column; background: #fff; border: 1px solid #e6e6e6; color: #000; transition: box-shadow .25s, transform .25s; }
  .hd-svc__card:hover { box-shadow: 0 12px 30px rgba(0,0,0,.08); transform: translateY(-3px); }
  .hd-svc__card img { width: 100%; height: auto; aspect-ratio: 10/7; object-fit: cover; display: block; }
  .hd-svc__body { padding: 20px 20px 22px; display: flex; flex-direction: column; flex: 1; }
  .hd-svc__body h3 { font-size: 17px; line-height: 24px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; margin: 0 0 8px; }
  .hd-svc__body p { font-size: 15px; line-height: 23px; font-weight: 300; color: #444; margin: 0 0 16px; flex: 1; }
  .hd-ticker { overflow: hidden; background: #000; color: #fff; padding: 22px 0; font-family: var(--ff-head); }
  .hd-ticker__track { display: flex; gap: 0; width: max-content; animation: hd-tick 40s linear infinite; }
  .hd-ticker span { font-size: 26px; font-weight: 300; letter-spacing: 3px; text-transform: uppercase; white-space: nowrap; }
  .hd-ticker span::after { content: '•'; margin: 0 34px; color: #777; }
  @keyframes hd-tick { to { transform: translateX(-50%); } }
  @keyframes hd-logos { to { transform: translateX(calc(-50% - 18px)); } }
  @media (prefers-reduced-motion: reduce) { .hd-ticker__track, .hd-approved ul { animation: none !important; } }
  .hd-steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(5, 1fr); position: relative; }
  .hd-steps::before { content: ''; position: absolute; left: 10%; right: 10%; top: 32px; border-top: 1px dashed #bbb; }
  .hd-steps li { position: relative; text-align: center; padding: 0 10px; }
  .hd-steps__ico { position: relative; display: inline-flex; width: 64px; height: 64px; align-items: center; justify-content: center; border: 1px solid #222; border-radius: 50%; background: #fff; }
  .hd-steps b { display: block; margin-top: 14px; font-size: 13px; color: #999; letter-spacing: 2px; }
  .hd-steps h3 { font-size: 17px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; margin: 4px 0 4px; }
  .hd-steps p { font-size: 14px; line-height: 21px; color: #555; margin: 0; }
  .hd-approved { text-align: center; padding: 60px 40px; background: #fafafa; font-family: var(--ff-head); }
  .hd-approved ul { list-style: none; margin: 0 auto; padding: 0; max-width: 1100px; display: grid; grid-template-columns: repeat(6, 1fr); gap: 30px; align-items: center; }
  .hd-approved img { max-width: 130px; max-height: 80px; width: auto; height: auto; margin: 0 auto; display: block; filter: grayscale(1); mix-blend-mode: multiply; }
  .hd-dup { display: none; }
  .hd-approved p { margin: 30px 0 0; font-size: 14px; letter-spacing: 1px; color: #555; }
  .hd-proj { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px 22px; }
  .hd-proj a { color: #000; }
  .hd-proj img { width: 100%; height: auto; aspect-ratio: 4/3; object-fit: cover; display: block; }
  .hd-proj h3 { font-size: 16px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; margin: 14px 0 2px; }
  .hd-proj span { font-size: 14px; color: #c0392b; }
  .hd-quotes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .hd-quotes figure { margin: 0; background: #fff; padding: 28px; }
  .hd-quotes blockquote { margin: 0 0 18px; font-size: 16px; line-height: 26px; font-style: italic; color: #333; }
  .hd-quotes b { display: block; font-size: 14px; text-transform: uppercase; letter-spacing: 1px; }
  .hd-quotes span { font-size: 13px; color: #777; }
  .hd-faq details { border-bottom: 1px solid #ddd; padding: 16px 0; }
  .hd-faq summary { cursor: pointer; font-size: 17px; font-weight: 600; list-style: none; }
  .hd-faq summary::after { content: '+'; float: right; font-weight: 300; }
  .hd-faq details[open] summary::after { content: '–'; }
  .hd-faq p { font-size: 15px; line-height: 25px; color: #444; margin: 12px 0 0; }
  @media (max-width: 991px) {
    .hd-hero { height: 600px; }
    .hd-hero__content { left: 20px; right: 20px; top: auto; bottom: 90px; transform: none; }
    .hd-hero h1 { font-size: 34px; line-height: 42px; letter-spacing: 2px; }
    .hd-hero p { font-size: 16px; line-height: 25px; margin-bottom: 22px; }
    .hd-hero::after { background: linear-gradient(0deg, rgba(0,0,0,.8) 0%, rgba(0,0,0,.3) 60%, rgba(0,0,0,.1) 100%); }
    .hd-stats { grid-template-columns: repeat(2, 1fr); gap: 10px; padding: 28px 16px; }
    .hd-stats b { font-size: 40px; }
    .hd-stats span { font-size: 11px; letter-spacing: .8px; }
    .hd-stats > div:nth-child(n+3) { display: none; }
    .hd-sec { padding: 46px 16px; }
    .hd-h2 { font-size: 24px; margin-bottom: 24px; }
    .hd-h2--big { font-size: 30px; line-height: 40px; }
    .hd-svc { grid-template-columns: repeat(2, 1fr); gap: 14px; }
    .hd-ticker span { font-size: 18px; }
    .hd-steps { grid-template-columns: 1fr; gap: 22px; }
    .hd-steps::before { left: 32px; right: auto; top: 10px; bottom: 10px; border-top: 0; border-left: 1px dashed #bbb; }
    .hd-steps li { display: grid; grid-template-columns: 64px 1fr; column-gap: 18px; text-align: left; padding: 0; align-items: center; }
    .hd-steps__ico { grid-row: span 3; }
    .hd-steps b { margin: 0; }
    .hd-approved { padding: 44px 16px; }
    .hd-approved__vp { overflow: hidden; margin: 0 -16px; }
    .hd-approved ul { display: flex; gap: 36px; width: max-content; max-width: none; background: #fafafa; animation: hd-logos 22s linear infinite; }
    .hd-approved li { flex: 0 0 auto; }
    .hd-approved img { max-width: 100px; max-height: 56px; }
    .hd-dup { display: list-item; }
    .hd-proj { grid-template-columns: repeat(2, 1fr); gap: 20px 12px; }
    .hd-quotes { grid-template-columns: 1fr; }
  }
  @media (max-width: 599px) { .hd-svc, .hd-proj { grid-template-columns: 1fr; } }
</style>
