---
// DRAFT A: full-width map with address card + black contact band (noindex, not in sitemap)
import Base from '../layouts/Base.astro';
import LineIcon from '../components/LineIcon.astro';
import Logos from '../components/Logos.astro';
import { logosInner, site } from '../data/site';
import '../styles/pages.css';
---
<Base title="Contact Crystal Fit – draft A" noindex>
  <section class="ca-map">
    <iframe title="Crystal Fit Contracting LLC on Google Maps" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src={site.mapEmbed}></iframe>
    <div class="ca-card">
      <h1>Contact us</h1>
      <p class="ca-card__name">Crystal Fit Contracting LLC</p>
      <p>Al Quoz Industrial 3<br />Ghoshi Warehouse City, WH-132<br />Dubai, UAE</p>
      <p class="ca-card__hint">How to find us: [short directions — gate, entrance, parking — text to be provided]</p>
      <a class="ca-btn" href={site.mapUrl} target="_blank" rel="noopener"><LineIcon name="pin" size={16} /> Get directions</a>
    </div>
  </section>
  <section class="ca-band">
    <a href={`tel:${site.phoneOffice}`}><LineIcon name="phone" size={30} stroke={1.2} /><b>Call</b><span>+971 4 320 2224</span></a>
    <a href={site.whatsapp} target="_blank" rel="noopener"><LineIcon name="chat" size={30} stroke={1.2} /><b>WhatsApp</b><span>{site.phoneMobileDisplay}</span></a>
    <a href={`mailto:${site.email}`}><LineIcon name="mail" size={30} stroke={1.2} /><b>Email</b><span>{site.email}</span></a>
    <div><LineIcon name="clock" size={30} stroke={1.2} /><b>Working hours</b><span>Mon – Sat: 09:00 – 18:00<br />Sunday: closed</span></div>
  </section>
  <Logos list={logosInner} />
</Base>
<style is:global>
  .ca-map { position: relative; height: 72vh; min-height: 480px; background: #e9e9e9; }
  .ca-map iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .ca-card { position: absolute; left: 60px; top: 50%; transform: translateY(-50%); width: 380px; background: #fff; padding: 34px 34px 30px; box-shadow: 0 10px 40px rgba(0,0,0,.18); font-family: var(--ff-head); }
  .ca-card h1 { font-size: 30px; line-height: 34px; font-weight: 900; text-transform: uppercase; color: var(--dark); margin: 0 0 16px; }
  .ca-card p { font-size: 15px; line-height: 25px; color: #333; margin: 0 0 14px; }
  .ca-card__name { font-weight: 700; letter-spacing: .5px; text-transform: uppercase; font-size: 14px !important; }
  .ca-card__hint { font-size: 13px !important; line-height: 21px !important; color: #777 !important; border-left: 2px solid #ddd; padding-left: 12px; }
  .ca-btn { display: inline-flex; align-items: center; gap: 8px; background: #000; color: #fff; padding: 14px 24px; font-size: 13px; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; margin-top: 6px; }
  .ca-btn:hover { opacity: .85; }
  .ca-band { background: #000; color: #fff; display: grid; grid-template-columns: repeat(4, 1fr); padding: 60px 60px; gap: 30px; font-family: var(--ff-head); }
  .ca-band > * { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 10px; color: #fff; }
  .ca-band b { font-size: 14px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; }
  .ca-band span { font-size: 16px; line-height: 25px; font-weight: 300; color: #ddd; }
  .ca-band a:hover span { color: #fff; text-decoration: underline; }
  @media (max-width: 767px) {
    .ca-map { height: auto; min-height: 0; display: flex; flex-direction: column; }
    .ca-map iframe { position: static; height: 360px; }
    .ca-card { position: static; transform: none; width: auto; box-shadow: none; padding: 26px 16px; }
    .ca-band { grid-template-columns: 1fr 1fr; padding: 40px 16px; gap: 30px 12px; }
    .ca-band span { font-size: 14px; word-break: break-word; }
  }
</style>
