---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Masonry from '../components/Masonry.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CtaBand from '../components/CtaBand.astro';
import Logos from '../components/Logos.astro';
import { logosInner } from '../data/site';
import hero from '../assets/site/hero-portfolio-retouched.jpg';
import '../styles/portfolio.css';
import { Image } from 'astro:assets';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).filter((p) => p.data.listed).sort((a, b) => a.data.order - b.data.order);
const listSchema = [{ '@type': 'CollectionPage', name: 'Crystal Fit portfolio', url: new URL('/portfolio/', Astro.site).href,
  mainEntity: { '@type': 'ItemList', numberOfItems: projects.length, itemListElement: projects.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.data.title, url: new URL(`/featured-projects/${p.id}/`, Astro.site).href })) } }];
const feat = ['wala-coffee-roastery','roasters-coffee-kiosk-dubai-mall','gary-tatintsian-gallery','anantara-penthouse','amv-aesthetic-clinic'].map((id) => projects.find((p) => p.id === id)!).filter(Boolean);
const catName: Record<string, string> = { fb: 'Food & Beverage (F&B)', commercial: 'Commercial', residential: 'Residential' };
const filters: [string, string][] = [['*', 'Show all'], ['fb', 'Food & Beverage (F&B)'], ['commercial', 'Commercial'], ['residential', 'Residential']];
---
<Base schema={listSchema} title="Fit-Out & Interior Design Portfolio, Dubai | Crystal Fit" noindex description="Completed fit-outs in Dubai and the UAE: specialty coffee shops, restaurants, offices, clinics and villas, approved by Emaar, Dubai Holding and TECOM.">
  <section class="pb">
    <div class="pb__head"><h1>Our work</h1><p>F&amp;B, commercial and residential fit-outs in Dubai — designed, approved and built by one team.</p></div>
    <div class="pb__grid">
      {feat.map((p, i) => (
        <a class:list={['pb__tile', { 'pb__tile--big': i === 0 }]} href={`/featured-projects/${p.id}/`}>
          <Image src={p.data.cover} alt={p.data.title} widths={i === 0 ? [640, 960, 1280] : [400, 640]} sizes={i === 0 ? '(min-width: 768px) 50vw, 100vw' : '(min-width: 768px) 25vw, 50vw'} loading="eager" quality={72} />
          <span><b>{p.data.title}</b><small>{p.data.categories.map((c) => catName[c]).join(' · ')}</small></span>
        </a>
      ))}
    </div>
  </section>
  <ul class="pfilter" aria-label="Filter projects by type">
    {filters.map(([key, label]) => (
      <li><a href={key === '*' ? '#' : `#${key}`} data-f={key} class:list={{ 'is-active': key === '*' }}>{label}<sup>{key === '*' ? projects.length : projects.filter((p) => p.data.categories.includes(key as any)).length}</sup></a></li>
    ))}
  </ul>
  <section class="pgrid">
    <Masonry id="portfolio-grid" class="pgrid__list">
      {projects.map((p, i) => <ProjectCard p={p} eager={i < 2} />)}
    </Masonry>
  </section>
  <script>
    const grid = document.getElementById('portfolio-grid') as HTMLElement & { relayout?: () => void };
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.pfilter a')];
    const apply = (f: string) => {
      links.forEach((a) => a.classList.toggle('is-active', a.dataset.f === f));
      grid.querySelectorAll<HTMLElement>('.pcard').forEach((c) => { c.hidden = f !== '*' && !c.dataset.cats!.split(' ').includes(f); });
      grid.relayout?.();
    };
    links.forEach((a) => a.addEventListener('click', (e) => {
      e.preventDefault();
      const f = a.dataset.f!;
      history.replaceState(null, '', f === '*' ? location.pathname : `#${f}`);
      apply(f);
    }));
    const fromHash = () => { const h = location.hash.slice(1); apply(links.some((a) => a.dataset.f === h) ? h : '*'); };
    addEventListener('hashchange', fromHash);
    if (location.hash) fromHash();
  </script>
  <CtaBand title="still having questions ?" label="Contact us" href="/contact/" />
  <Logos list={logosInner} />
</Base>

<style is:global>
  .pb { background: #000; color: #fff; padding: 50px 40px 40px; margin-bottom: 50px; font-family: var(--ff-head); }
  .pb__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 40px; margin-bottom: 30px; }
  .pb h1 { font-size: 64px; line-height: 1; font-weight: 400; letter-spacing: 5px; text-transform: uppercase; margin: 0; }
  .pb__head p { font-size: 17px; line-height: 27px; font-weight: 300; color: #ccc; max-width: 460px; margin: 0; text-align: right; }
  .pb__grid { display: grid; grid-template-columns: 2fr 1fr 1fr; grid-template-rows: 240px 240px; gap: 10px; }
  .pb__tile { position: relative; overflow: hidden; display: block; background: #222; }
  .pb__tile--big { grid-row: 1 / 3; }
  .pb__tile img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s; display: block; }
  .pb__tile:hover img { transform: scale(1.04); }
  .pb__tile::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(0,0,0,.7), rgba(0,0,0,0) 55%); }
  .pb__tile span { position: absolute; z-index: 1; left: 16px; right: 16px; bottom: 14px; }
  .pb__tile b { display: block; font-size: 14px; line-height: 19px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; }
  .pb__tile small { font-size: 12px; color: #ccc; }
  .pb__tile--big b { font-size: 20px; line-height: 26px; }
  @media (max-width: 767px) { .pb { padding: 30px 16px 16px; margin-bottom: 20px; } .pb__head { display: block; margin-bottom: 20px; } .pb h1 { font-size: 40px; letter-spacing: 3px; margin-bottom: 10px; } .pb__head p { text-align: left; font-size: 15px; line-height: 24px; } .pb__grid { grid-template-columns: 1fr 1fr; grid-template-rows: 220px 140px 140px; gap: 8px; } .pb__tile--big { grid-row: auto; grid-column: 1 / -1; } .pb__tile b { font-size: 11px; line-height: 15px; } .pb__tile small { display: none; } .pb__tile--big b { font-size: 15px; } .pb__grid { grid-template-rows: 220px 140px 140px; } }
</style>
