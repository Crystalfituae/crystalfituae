---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import Masonry from '../../../components/Masonry.astro';
import Icon from '../../../components/Icon.astro';
import { categories } from '../../../data/site';
import catOrder from '../../../data/category-order.json';

export const getStaticPaths = (async ({ paginate }) => {
  const rank = (c: string, id: string) => { const i = (catOrder as Record<string, string[]>)[c].indexOf(id); return i < 0 ? 999 : i; };
  const all = (await getCollection('projects')).filter((p) => p.data.listed).sort((a, b) => a.data.order - b.data.order);
  return (Object.keys(categories) as (keyof typeof categories)[]).flatMap((cat) =>
    paginate(all.filter((p) => p.data.categories.includes(cat)).sort((a, b) => rank(cat, a.id) - rank(cat, b.id)), { params: { cat }, pageSize: 10 }),
  );
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const cat = Astro.params.cat as keyof typeof categories;
const label = cat === 'fb' ? 'Food & Beverage (F&B)' : categories[cat];
const seoName = { commercial: 'Commercial Fit-Out Projects, Dubai', fb: 'Cafe & Restaurant Fit-Out Projects', residential: 'Residential Interior Projects, Dubai' };
const seoDesc = {
  commercial: 'Commercial fit-out projects by Crystal Fit: offices, retail, clinics, galleries and hotels delivered design & build across Dubai and the UAE.',
  fb: 'Cafe, coffee shop and restaurant fit-outs by Crystal Fit in Dubai: Roasters, WALA, YOY Neo Bistro and more, from design to landlord approvals and handover.',
  residential: 'Villa and apartment interior design and fit-out projects by Crystal Fit in Dubai, Sharjah and across the UAE.',
};
---
<Base title={`${seoName[cat]}${page.currentPage > 1 ? ` – Page ${page.currentPage}` : ''} | Crystal Fit`} description={seoDesc[cat]} form={false}>
  <div class="catbar">
    <h4>{label}</h4>
    <ol class="catbar__crumbs"><li><a href="/">Home</a></li><li class="sep">/</li><li><a href="/portfolio/">Featured-Projects</a></li><li class="sep">/</li><li class="cur">{label}</li></ol>
  </div>
  <h1 class="cattitle">Featured-Projects Category: <span>{label}</span></h1>
  <section class="catgrid">
    <Masonry id="catgrid" cols={[{ min: 768, n: 3 }, { min: 0, n: 1 }]}>
      {page.data.map((p) => (
        <article class="catcard" data-span="1">
          <a href={`/featured-projects/${p.id}/`} style={`aspect-ratio:${p.data.cover.width}/${p.data.cover.height}`}>
            <Image src={p.data.cover} alt={p.data.title} widths={[360, 410, 640, 820]} sizes="(min-width: 768px) 410px, 100vw" loading="lazy" />
            <span class="catcard__meta">
              <span class="catcard__title">{p.data.title}</span>
              <span class="catcard__cats">{p.data.categories.map((c) => <span>{categories[c]}</span>)}</span>
            </span>
          </a>
        </article>
      ))}
    </Masonry>
  </section>
  <nav class="catpager" aria-label="Pagination">
    {page.url.prev ? <a href={page.url.prev.replace(/\/?$/, '/')} aria-label="Previous page"><Icon name="angle-left" size={14} /></a> : <span></span>}
    {page.url.next ? <a href={page.url.next.replace(/\/?$/, '/')} aria-label="Next page"><Icon name="angle-right" size={14} /></a> : <span></span>}
  </nav>
</Base>
<style>
  .catbar { background: #f5f6f7; height: 116px; display: flex; align-items: center; justify-content: space-between; padding: 0 32px; }
  .catbar h4 { font-size: 22px; line-height: 28px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; color: #222; }
  .catbar__crumbs { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; color: #666; }
  .catbar__crumbs .sep { font-size: 12px; padding: 0 2px; }
  .catbar__crumbs .cur { color: #222; }
  .cattitle { padding: 0 55px; font-size: 26px; line-height: 36px; font-weight: 600; letter-spacing: 4px; text-transform: uppercase; color: #222; }
  .catgrid { padding: 96px 30px 0; max-width: 1440px; margin: 0 auto; }
  .catgrid :global(.masonry) { max-width: 1380px; margin: 0 auto; }
  .catcard { padding: 0 25px; margin-bottom: 50px; }
  .catcard a { position: relative; display: block; overflow: hidden; background: #f3f3f3; }
  .catcard img { width: 100%; height: 100%; object-fit: cover; }
  .catcard__meta { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 20px; background: rgba(255,255,255,.9); opacity: 0; transition: opacity .3s; }
  .catcard a:hover .catcard__meta { opacity: 1; }
  .catcard__title { font-size: 15px; line-height: 20px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; color: #222; }
  .catcard__cats { display: flex; gap: 8px; font-size: 13px; line-height: 32px; color: #444; }
  .catpager { display: flex; justify-content: space-between; padding: 20px 55px 100px; }
  .catpager a { color: #222; padding: 10px; }
  @media (max-width: 767px) {
    .catbar { height: auto; padding: 30px 15px; flex-direction: column; align-items: flex-start; gap: 6px; }
    .cattitle { padding: 20px 15px 0; font-size: 18px; line-height: 26px; letter-spacing: 2px; }
    .catgrid { padding: 40px 15px 0; }
    .catcard { padding: 0; margin-bottom: 30px; }
    .catpager { padding: 10px 15px 60px; }
  }
</style>
