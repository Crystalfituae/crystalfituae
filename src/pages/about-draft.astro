---
// DRAFT: modern About page — less text, people first (noindex, not in sitemap)
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import Logos from '../components/Logos.astro';
import LineIcon from '../components/LineIcon.astro';
import { logosInner } from '../data/site';
import '../styles/pages.css';
// placeholder until the team group photo is shot: our office facade in Al Quoz
import heroPhoto from '../assets/about/hero-office.jpg';
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/about/team-*.jpg', { eager: true });
const ph = (n: string) => photos[`../assets/about/team-${n}.jpg`].default;
const team = [
  ['alina', 'Alina D.', 'Business Development Manager'], ['vignesh', 'Vignesh V.', 'MEP Project Manager'], ['vladimir', 'Vladimir H.', 'Project Manager'],
  ['apple', 'Apple C.', 'Administrator'], ['abishikth', 'Abishikth', 'Head of Accounts'], ['gerin', 'Gerin K.', 'Designer'], ['thejus', 'Thejus T.', 'Designer'],
  ['dhanesh', 'Dhanesh T.', '3D Visualizer'], ['saba', 'Saba F.', 'Designer'], ['stepan', 'Stepan R.', 'Site Coordinator'],
];
const stats: [string, string][] = [['2014', 'UAE grown since'], ['200+', 'Projects handed over'], ['90 days', 'Shell & core to opening'], ['100%', 'Approvals in‑house']];
const steps: [string, string, string][] = [
  ['file', 'Brief', 'Site visit & budget'],
  ['pen', 'Design', 'Concept, 3D, drawings'],
  ['clipboard', 'Approvals', 'Landlord & authorities'],
  ['helmet', 'Fit-out', 'Civil, MEP, joinery'],
  ['award', 'Handover', 'Snagging & warranty'],
];
---
<Base title="About Crystal Fit – draft" noindex>
  <section class="ad-hero">
    <Image src={heroPhoto} alt="Crystal Fit office in Al Quoz, Dubai" class="ad-hero__img" widths={[800, 1166]} sizes="100vw" loading="eager" />
    <div class="ad-hero__in">
      <h1>One team.<br />Since 2014.</h1>
      <p>Designers, engineers and builders under one roof in Al Quoz, Dubai.</p>
    </div>
    <span class="ad-note">placeholder — replace with team group photo</span>
  </section>

  <section class="ad-intro">
    <p class="ad-intro__lead">Dubai <strong>design &amp; build fit-out</strong> company. Food &amp; Beverage (F&amp;B), commercial and residential interiors — from concept and approvals to handover.</p>
    <div class="ad-stats">{stats.map(([n, t]) => { const [num, ...unit] = n.split(' '); return <div><b>{num}{unit.length > 0 && <small> {unit.join(' ')}</small>}</b><span>{t}</span></div>; })}</div>
  </section>

  <section class="ad-founder">
    <Image src={ph('konstantin')} alt="Konstantin Grytsan, CEO and founder of Crystal Fit" width={560} height={560} widths={[560, 1120]} sizes="(min-width: 768px) 560px, 100vw" fit="cover" loading="lazy" class="ad-founder__img" />
    <div class="ad-founder__txt">
      <p class="ad-founder__quote">“We build spaces that work for the business behind them — on time, on budget and to a standard we are proud to sign.”</p>
      <p class="ad-founder__name"><b>Konstantin Grytsan</b> · CEO &amp; Founder</p>
      <p class="ad-founder__path">Architect &amp; project manager<br />Berlin → Moscow → Doha → Dubai</p>
      <p class="ad-founder__creds">Heriot-Watt University · <a href="https://www.linkedin.com/in/konstantin-grytsan-1082a968/" target="_blank" rel="noopener">LinkedIn</a></p>
    </div>
  </section>

  <section class="ad-steps">
    <h2>How we work</h2>
    <ol>{steps.map(([i, t, d], n) => <li><span class="ad-steps__ico"><LineIcon name={i} size={28} stroke={1.3} /></span><b>{String(n + 1).padStart(2, '0')} · {t}</b><span>{d}</span></li>)}</ol>
  </section>

  <section class="ad-team">
    <h2>The team</h2>
    <div class="ad-team__grid">
      {team.map(([k, n, r]) => (
        <figure>
          <Image src={ph(k)} alt={`${n}, ${r} at Crystal Fit`} width={254} height={254} widths={[254, 508]} sizes="(min-width: 1200px) 254px, (min-width: 768px) 30vw, 50vw" fit="cover" loading="lazy" />
          <figcaption><b>{n}</b><span>{r}</span></figcaption>
        </figure>
      ))}
    </div>
  </section>

  <CtaBand title="LETS GROW TOGETHER" label="APPLY NOW" href="/contact/?topic=recruitment#contact-form" />
  <Logos list={logosInner} />
</Base>
<style is:global>
  .ad-hero { position: relative; height: 620px; overflow: hidden; background: #111; color: #fff; font-family: var(--ff-head); }
  .ad-hero__img { width: 100%; height: 100%; object-fit: cover; }
  .ad-hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(0,0,0,.75), rgba(0,0,0,.1) 60%); }
  .ad-hero__in { position: absolute; z-index: 1; left: 60px; bottom: 70px; }
  .ad-hero h1 { font-size: 64px; line-height: 70px; font-weight: 400; letter-spacing: 3px; text-transform: uppercase; margin: 0 0 14px; }
  .ad-hero p { font-size: 19px; line-height: 28px; font-weight: 300; margin: 0; }
  .ad-note { position: absolute; z-index: 1; right: 16px; top: 16px; font-size: 12px; background: #ffd400; color: #000; padding: 4px 8px; font-family: var(--ff-body); }

  .ad-intro { max-width: 1180px; margin: 0 auto; padding: 80px 40px 70px; text-align: center; font-family: var(--ff-head); }
  .ad-intro__lead { font-size: 26px; line-height: 40px; font-weight: 300; color: var(--dark); max-width: 900px; margin: 0 auto 56px; }
  .ad-intro__lead strong { font-weight: 600; }
  .ad-stats { display: grid; grid-template-columns: repeat(4, 1fr); }
  .ad-stats b { display: block; font-size: 56px; line-height: 1.1; font-weight: 600; color: var(--dark); margin-bottom: 8px; }
  .ad-stats b small { font-size: .45em; }
  .ad-stats span { font-size: 14px; letter-spacing: 1.5px; text-transform: uppercase; font-weight: 600; color: #222; }

  .ad-founder { background: #000; color: #fff; display: grid; grid-template-columns: 560px 1fr; align-items: center; font-family: var(--ff-head); }
  .ad-founder__img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; display: block; filter: grayscale(1); }
  .ad-founder__txt { padding: 60px 80px; max-width: 720px; }
  .ad-founder__quote { font-size: 30px; line-height: 44px; font-weight: 300; margin: 0 0 30px; }
  .ad-founder__name { font-size: 15px; letter-spacing: 1.5px; text-transform: uppercase; margin: 0 0 10px; }
  .ad-founder__path { font-size: 17px; line-height: 28px; font-weight: 300; color: #cfcfcf; margin: 0 0 18px; }
  .ad-founder__creds { font-size: 12px; letter-spacing: 1.5px; text-transform: uppercase; color: #999; margin: 0; }
  .ad-founder__creds a { color: #fff; text-decoration: underline; }

  .ad-steps { max-width: 1240px; margin: 0 auto; padding: 80px 40px 40px; font-family: var(--ff-head); }
  .ad-steps h2, .ad-team h2 { font-size: 32px; line-height: 36px; font-weight: 900; text-transform: uppercase; color: var(--dark); margin: 0 0 40px; }
  .ad-steps ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 20px; position: relative; }
  .ad-steps ol::before { content: ''; position: absolute; left: 28px; right: 28px; top: 28px; border-top: 1px dashed #ccc; }
  .ad-steps li { position: relative; display: flex; flex-direction: column; gap: 6px; }
  .ad-steps__ico { display: inline-flex; width: 56px; height: 56px; align-items: center; justify-content: center; border: 1px solid #222; border-radius: 50%; background: #fff; margin-bottom: 10px; }
  .ad-steps b { font-size: 15px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; color: #000; }
  .ad-steps li > span:last-child { font-size: 15px; line-height: 22px; font-weight: 300; color: #555; }

  .ad-team { max-width: 1350px; margin: 0 auto; padding: 50px 40px 70px; font-family: var(--ff-head); }
  .ad-team__grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 26px 20px; }
  .ad-team figure { margin: 0; }
  .ad-team img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; display: block; filter: grayscale(1); transition: filter .4s; }
  .ad-team figure:hover img { filter: none; }
  .ad-team figcaption { padding-top: 14px; text-transform: uppercase; }
  .ad-team figcaption b { display: block; font-size: 14px; line-height: 21px; font-weight: 700; }
  .ad-team figcaption span { display: block; font-size: 12px; line-height: 20px; color: #555; }

  @media (max-width: 1100px) {
    .ad-founder { grid-template-columns: 1fr 1fr; }
    .ad-founder__txt { padding: 40px; }
    .ad-founder__quote { font-size: 24px; line-height: 36px; }
    .ad-team__grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 767px) {
    .ad-hero { height: 520px; }
    .ad-hero__in { left: 16px; right: 16px; bottom: 40px; }
    .ad-hero h1 { font-size: 40px; line-height: 46px; letter-spacing: 2px; }
    .ad-intro { padding: 50px 16px; }
    .ad-intro__lead { font-size: 20px; line-height: 32px; margin-bottom: 36px; }
    .ad-stats { grid-template-columns: 1fr 1fr; gap: 30px 10px; }
    .ad-stats b { font-size: 42px; }
    .ad-stats span { font-size: 11px; }
    .ad-founder { grid-template-columns: 1fr; }
    .ad-founder__txt { padding: 36px 16px 44px; }
    .ad-steps { padding: 50px 16px 20px; }
    .ad-steps ol { grid-template-columns: 1fr; gap: 18px; }
    .ad-steps ol::before { display: none; }
    .ad-steps li { flex-direction: row; flex-wrap: wrap; align-items: center; column-gap: 14px; }
    .ad-steps__ico { margin: 0; }
    .ad-steps li > span:last-child { flex-basis: 100%; padding-left: 70px; margin-top: -26px; }
    .ad-team { padding: 30px 16px 40px; }
    .ad-team__grid { grid-template-columns: repeat(2, 1fr); gap: 20px 12px; }
  }
</style>
