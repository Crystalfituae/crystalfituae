---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CtaBand from '../components/CtaBand.astro';
import Logos from '../components/Logos.astro';
import LineIcon from '../components/LineIcon.astro';
import { logosInner } from '../data/site';
import '../styles/pages.css';
import hero from '../assets/site/hero-about.jpg';
import builder from '../assets/about/builder-back.jpg';

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/about/team-*.jpg', { eager: true });
const ph = (n: string) => photos[`../assets/about/team-${n}.jpg`].default;
// [photo key or '' if no photo yet, name, role] — 6 per row
const team = [
  ['alina', 'Alina D.', 'Business Development Manager'], ['vladimir', 'Vladimir H.', 'Project Manager'], ['', 'Kiranraj', 'MEP Engineer'],
  ['', 'Alam', 'Site Foreman'], ['stepan', 'Stepan R.', 'Site Coordinator'], ['', 'Hema', 'Document Controller'],
  ['gerin', 'Gerin K.', 'Designer'], ['thejus', 'Thejus T.', 'Designer'], ['', 'Sofia', 'Designer'],
  ['saba', 'Saba F.', 'Procurement Designer'], ['dhanesh', 'Dhanesh T.', '3D Visualizer'], ['abishikth', 'Abishikth', 'Head of Accounts'],
  ['', 'Athira', 'Office Administrator'],
];
const initials = (n: string) => n.replace(/\./g, '').split(' ').map((w) => w[0]).join('').slice(0, 2).toUpperCase();
const why: [string, string, string][] = [
  ['award', 'Proven expertise', '200+ fit-out projects delivered in Dubai and the UAE since 2014.'],
  ['layers', 'One-stop solution', 'Design, approvals, MEP, construction and project management under one roof.'],
  ['shield', 'Approvals know-how', 'Landlord and authority approvals with Emaar, Dubai Holding, TECOM, Nakheel, DM, DCD and DEWA.'],
  ['clock', 'Time & quality', 'Programmes we keep and finishing standards we don’t compromise.'],
  ['target', 'Tailored approach', 'Every space reflects the client’s brand, vision and the way the business operates.'],
  ['calc', 'Cost transparency', 'Detailed BOQs, clear budgets and proactive value engineering.'],
  ['network', 'Trusted network', 'Long-term partners: specialist subcontractors, suppliers and manufacturers.'],
  ['growth', 'Long-term partnership', 'Not just a contractor — a strategic partner in your growth.'],
];
// TODO numbers to be confirmed by the owner
const facts: [string, string][] = [['200+', 'Projects completed'], ['38', 'Projects in Emaar properties'], ['58', 'Projects with Dubai Holding'], ['10', 'Projects in TECOM']];
const units: [string, string, string][] = [
  ['pen', 'Interior design studio', 'Concepts, space planning, material and furniture selection.'],
  ['cube', '3D visualisation', 'Photorealistic renders so you see the space before it is built.'],
  ['ruler', 'Technical & shop drawings', 'Architectural, joinery and approval drawing packages.'],
  ['bolt', 'MEP engineering', 'HVAC, electrical, plumbing, drainage and fire-fighting coordination.'],
  ['clipboard', 'Project management', 'Programme, budget, procurement and weekly client reporting.'],
  ['helmet', 'Site supervision', 'Site coordinators, HSE, quality control and snagging to handover.'],
];
const schema = [{ '@type': 'AboutPage', name: 'About Crystal Fit Contracting LLC', url: new URL('/about-us/', Astro.site).href,
  mainEntity: { '@id': new URL('/#company', Astro.site).href } },
  { '@type': 'Person', name: 'Konstantin Grytsan', jobTitle: 'CEO & Founder', worksFor: { '@id': new URL('/#company', Astro.site).href }, alumniOf: 'Heriot-Watt University', sameAs: ['https://www.linkedin.com/in/konstantin-grytsan-1082a968/'] }];
---
<Base noindex title="About Crystal Fit – Design & Build Fit-Out Team, Dubai" description="Dubai design & build fit-out team since 2014: 200+ projects for Roasters, Christie's, Mercure and Shangri-La. Approved by Emaar and Dubai Holding." schema={schema}>
  <Hero slides={[{ image: hero, lines: ['Who we', 'are'] }]} place="right-top" dark h1="— about Crystal Fit Contracting LLC, design & build fit-out company in Dubai" />
  <div class="hero-gap"></div>
  <!-- 1. Who we are: text left, builder photo right -->
  <section class="ab-intro">
    <div class="ab-intro__text">
      <p class="ab-lead"><strong>Crystal Fit Contracting LLC</strong> is a Dubai design &amp; build company that takes a space from the first sketch to opening day — with its own designers, engineers, project managers and builders.</p>
      <p>Since 2014 we have delivered <strong>200+ projects</strong> across the UAE: specialty coffee shops and restaurants, offices, clinics, galleries, hotels and private villas. Design, landlord and authority approvals, MEP, joinery and fit-out are handled by one in-house team — so the space you approve on the render is the space you get on site.</p>
      <p>We are known for attention to detail, transparent BOQs and programmes we keep. Every project is led personally from concept to handover.</p>
      <ul class="about__why">
        {why.map(([i, t, d]) => <li><LineIcon name={i} size={26} class="about__ico" /><div><strong>{t}</strong><span>{d}</span></div></li>)}
      </ul>
    </div>
    <div class="ab-intro__media">
      <Image src={builder} alt="Crystal Fit builder in a company T-shirt finishing drywall on site" widths={[480, 960]} sizes="(min-width: 992px) 40vw, 100vw" loading="lazy" quality={75} />
    </div>
  </section>

  <!-- 2. Our story -->
  <section class="ab-story">
    <h2 class="ab-h2">Our story</h2>
    <div class="ab-story__cols">
      <p>For years Konstantin Grytsan worked around the world as a lead designer and architect — from business parks and hotels in Berlin and Moscow to a private palace in Doha. On every project he met the same problem: it was hard to find builders who understood the designer’s idea, took real responsibility for the result and had an eye for beauty in the details.</p>
      <p>In 2014 he founded Crystal Fit in Dubai to close that gap. For the first years the company focused on interior design; step by step it grew into a full in-house fit-out team — with project managers, engineers, site coordinators and our own builders.</p>
      <p>Today design and construction sit under one roof. The people who draw a detail are the people who build it — that is why our spaces look exactly the way they were designed.</p>
    </div>
  </section>

  <!-- 3. Facts: projects by landlord + approvals know-how -->
  <section class="ab-facts">
    <div class="ab-facts__nums">
      {facts.map(([n, t]) => <div><b>{n}</b><span>{t}</span></div>)}
    </div>
    <p class="ab-facts__text"><strong>We know the approvals.</strong> We work every day with the fit-out guides of Emaar, Dubai Holding, TECOM and Nakheel and with the requirements of Dubai Municipality, Civil Defence and DEWA. We know what each landlord expects — so drawings are approved first time and the site is never stopped by avoidable mistakes.</p>
  </section>

  <section class="units">
    <h2 class="units__title">One in-house team for every stage</h2>
    <p class="units__sub">Designers, engineers and site specialists work as one team, backed by a network of trusted subcontractors and manufacturers.</p>
    <ul class="units__grid">
      {units.map(([i, t, d]) => <li><LineIcon name={i} size={34} stroke={1.3} /><h3>{t}</h3><p>{d}</p></li>)}
    </ul>
  </section>

  <!-- 4. Team behind the magic: band, CEO block, team grid 6 per row -->
  <section class="ab-band"><h2 class="ab-band__title">Team behind the magic</h2></section>
  <section class="team">
    <div class="team__lead">
      <figure>
        <Image src={ph('konstantin')} alt="Konstantin Grytsan, CEO and founder of Crystal Fit" width={487} height={487} widths={[487, 974]} sizes="(min-width: 768px) 487px, 100vw" fit="cover" loading="lazy" />
        <figcaption><b>Konstantin Grytsan</b><span>CEO / Founder</span></figcaption>
      </figure>
      <div class="team__bio">
        <p class="team__quote">“Design is a promise. Our job is to keep it — in every joint, every detail and every deadline.”</p>
        <p>Architect and project manager. Before Crystal Fit, Konstantin designed and led business parks, hotels and mixed-use towers in Berlin and Moscow and a 12,000 sqm private palace in Doha. In 2014 he founded Crystal Fit in Dubai — today a design &amp; build team with 200+ completed projects, from Roasters and WALA to Christie’s and Mercure Gold Hotel.</p>
        <ul class="team__mottos">
          <li>Beautiful is not enough — a space has to work for the business behind it.</li>
          <li>One team, one responsibility: from the first sketch to the last detail.</li>
          <li>We hand over only what we are proud to sign.</li>
        </ul>
        <p class="team__creds">Heriot-Watt University, Project Management · Certified ARCHICAD &amp; AutoCAD specialist · <a href="https://www.linkedin.com/in/konstantin-grytsan-1082a968/" target="_blank" rel="noopener">LinkedIn</a></p>
      </div>
    </div>
    <div class="team__grid team__grid--6">
      {team.map(([k, n, r]) => (
        <figure>
          {k ? <Image src={ph(k)} alt={`${n}, ${r} at Crystal Fit`} width={254} height={254} widths={[254, 508]} sizes="(min-width: 1200px) 200px, (min-width: 768px) 30vw, 50vw" fit="cover" loading="lazy" />
             : <div class="team__ph" aria-hidden="true">{initials(n)}</div>}
          <figcaption><b>{n}</b><span>{r}</span></figcaption>
        </figure>
      ))}
    </div>
  </section>

  <CtaBand title="LETS GROW TOGETHER" label="APPLY NOW" href="/contact/?topic=recruitment#contact-form" />
  <Logos list={logosInner} />
</Base>
<style is:global>
  .ab-band { background: #000; color: #fff; padding: 70px 40px; text-align: center; }
  .ab-band__title { font-family: var(--ff-head); font-size: 46px; line-height: 1.15; font-weight: 400; letter-spacing: 6px; text-transform: uppercase; margin: 0; }
  .team__mottos { list-style: none; margin: 0 0 18px; padding: 0; }
  .team__mottos li { position: relative; padding-left: 18px; margin-bottom: 8px; font-weight: 500; color: #000; }
  .team__mottos li::before { content: ''; position: absolute; left: 0; top: 12px; width: 7px; height: 7px; background: #000; }
  .team__grid--6 { grid-template-columns: repeat(6, 1fr) !important; }
  .team__ph { aspect-ratio: 1; background: #e9e9e9; display: flex; align-items: center; justify-content: center; font-family: var(--ff-head); font-size: 40px; font-weight: 300; letter-spacing: 3px; color: #9a9a9a; }
  @media (max-width: 1100px) { .team__grid--6 { grid-template-columns: repeat(3, 1fr) !important; } }
  @media (max-width: 767px) { .team__grid--6 { grid-template-columns: repeat(2, 1fr) !important; } .ab-band { padding: 46px 16px; } .ab-band__title { font-size: 28px; letter-spacing: 3px; } }
  .ab-intro { background: #000; color: #fff; display: grid; grid-template-columns: 1fr 40%; gap: 60px; align-items: center; padding: 30px 50px 70px 45px; font-family: var(--ff-head); font-size: 17px; line-height: 30px; font-weight: 300; }
  .ab-intro p { margin: 0 0 16px; }
  .ab-intro p strong { font-weight: 600; }
  .ab-lead { font-size: 21px !important; line-height: 34px !important; }
  .ab-intro__media img { width: 100%; height: auto; aspect-ratio: 4/5; object-fit: cover; display: block; }
  .ab-h2 { font-family: var(--ff-head); font-size: 42px; line-height: 1.15; font-weight: 400; letter-spacing: 4px; text-transform: uppercase; margin: 0 0 34px; }
  .ab-story { max-width: 1350px; margin: 0 auto; padding: 80px 40px 70px; color: #000; }
  .ab-story__cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; font-family: var(--ff-head); font-size: 17px; line-height: 30px; font-weight: 300; color: #333; }
  .ab-story__cols p { margin: 0; border-top: 1px solid #000; padding-top: 20px; }
  .ab-facts { background: #3e3e3e; color: #fff; padding: 70px 40px; font-family: var(--ff-head); }
  .ab-facts__nums { max-width: 1180px; margin: 0 auto 44px; display: grid; grid-template-columns: repeat(4, 1fr); text-align: center; gap: 20px; }
  .ab-facts__nums b { display: block; font-size: 62px; line-height: 1.1; font-weight: 800; letter-spacing: 4px; font-variant-numeric: lining-nums; margin-bottom: 10px; }
  .ab-facts__nums span { display: block; font-size: 14px; letter-spacing: 3px; text-transform: uppercase; font-weight: 700; color: #ddd; }
  .ab-facts__text { max-width: 860px; margin: 0 auto; text-align: center; font-size: 18px; line-height: 31px; font-weight: 300; color: #eee; }
  .ab-facts__text strong { display: block; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: #fff; margin-bottom: 8px; }
  @media (max-width: 991px) {
    .ab-intro { grid-template-columns: 1fr; gap: 30px; padding: 30px 16px 50px; }
    .ab-story { padding: 50px 16px; }
    .ab-story__cols { grid-template-columns: 1fr; gap: 26px; }
    .ab-h2 { font-size: 30px; letter-spacing: 2px; margin-bottom: 24px; }
    .ab-facts { padding: 50px 16px; }
    .ab-facts__nums { grid-template-columns: repeat(2, 1fr); row-gap: 30px; }
    .ab-facts__nums b { font-size: 46px; letter-spacing: 2px; }
    .ab-facts__nums span { font-size: 12px; letter-spacing: 1.5px; }
    .ab-lead { font-size: 18px !important; line-height: 30px !important; }
  }
  .about__lead { font-size: 19px; line-height: 32px; }
  .about__text p strong { font-weight: 600; }
  .about__why { list-style: none; margin: 34px 0 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 22px 34px; }
  .about__why li { display: flex; gap: 14px; align-items: flex-start; }
  .about__ico { flex: 0 0 auto; margin-top: 3px; color: #fff; }
  .about__why strong { display: block; font-size: 15px; line-height: 22px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; }
  .about__why span { display: block; font-size: 15px; line-height: 23px; color: #cfcfcf; }
  .units { max-width: 1350px; margin: 0 auto; padding: 70px 40px 30px; font-family: var(--ff-head); }
  .units__title, .team__title { font-family: var(--ff-head); font-size: 26px; line-height: 32px; font-weight: 700; letter-spacing: .5px; text-transform: uppercase; color: #000; margin: 0 0 14px; }
  .units__sub { font-size: 17px; line-height: 28px; font-weight: 300; color: #444; max-width: 760px; margin: 0 0 36px; }
  .units__grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 34px 40px; }
  .units__grid li { border-top: 1px solid #ddd; padding-top: 20px; color: #000; }
  .units__grid h3 { font-size: 17px; line-height: 24px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; margin: 14px 0 6px; }
  .units__grid p { font-size: 15px; line-height: 24px; font-weight: 300; color: #444; margin: 0; }
  /* team: one left edge for the lead photo and the grid */
  .team { max-width: 1350px; margin: 0 auto; padding: 50px 40px 30px; }
  .team__title { margin-bottom: 36px; }
  .team__lead { display: grid; grid-template-columns: 487px 1fr; gap: 60px; align-items: center; width: auto; margin: 0 0 40px !important; }
  .team__lead figure { margin: 0; }
  .team__lead img { width: 487px; height: 487px; object-fit: cover; display: block; }
  .team__bio { font-family: var(--ff-head); font-size: 17px; line-height: 29px; font-weight: 300; color: #333; max-width: 640px; }
  .team__bio p { margin: 0 0 16px; }
  .team__creds { font-size: 13px !important; line-height: 21px !important; letter-spacing: 1px; text-transform: uppercase; color: #777; }
  .team__creds a { color: #000; text-decoration: underline; }
  .team__quote { font-size: 22px; line-height: 34px; font-weight: 400; font-style: italic; color: #000; border-left: 2px solid #000; padding-left: 20px; margin-bottom: 26px !important; }
  .team figure { margin: 0; }
  .team figcaption { padding-top: 16px; color: #000; font-family: var(--ff-head); text-transform: uppercase; }
  .team figcaption b { display: block; font-size: 14px; line-height: 21px; font-weight: 700; letter-spacing: .5px; }
  .team figcaption span { display: block; font-size: 12px; line-height: 21px; font-weight: 400; color: #555; }
  .team__grid { display: grid; grid-template-columns: repeat(5, 1fr); column-gap: 20px; row-gap: 26px; padding: 0; }
  .team__grid img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; display: block; }
  @media (max-width: 1100px) {
    .about__why { grid-template-columns: 1fr; }
    .units__grid { grid-template-columns: repeat(2, 1fr); }
    .team__lead { grid-template-columns: 1fr 1fr; gap: 36px; }
    .team__lead img { width: 100%; height: auto; aspect-ratio: 1; }
    .team__grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 767px) {
    .units { padding: 44px 16px 10px; }
    .units__grid { grid-template-columns: 1fr; gap: 24px; }
    .team { padding: 30px 16px 20px; }
    .team__title { margin: 0 0 20px; }
    .team__lead { grid-template-columns: 1fr; gap: 22px; margin: 0 0 30px !important; }
    .team__bio { font-size: 16px; line-height: 27px; }
    .team__quote { font-size: 19px; line-height: 29px; }
    .team__grid { grid-template-columns: repeat(2, 1fr); column-gap: 12px; }
  }
</style>
