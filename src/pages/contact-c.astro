---
// DRAFT C: photo banner with Call / WhatsApp + full-width map + info row (noindex, not in sitemap)
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import LineIcon from '../components/LineIcon.astro';
import Logos from '../components/Logos.astro';
import { logosInner, site } from '../data/site';
import '../styles/pages.css';
// placeholder photo (SELF.SPACE studio, also in Ghoshi Warehouse City) — to be replaced with a real photo of our office / workshop
import photo from '../content/projects/self-space-studio-dubai/img/10-untitled.jpg';
---
<Base title="Contact Crystal Fit – draft C" noindex>
  <section class="cc-hero">
    <Image src={photo} alt="" class="cc-hero__img" widths={[800, 1440, 1920]} sizes="100vw" loading="eager" />
    <div class="cc-hero__in">
      <h1>Visit our studio<br />in Al Quoz</h1>
      <p>Design office and workshop under one roof. Call, message or drop by for a coffee and a material board.</p>
      <div class="cc-hero__btns">
        <a class="cc-btn cc-btn--white" href={`tel:${site.phoneOffice}`}><LineIcon name="phone" size={16} /> Call +971 4 320 2224</a>
        <a class="cc-btn cc-btn--line" href={site.whatsapp} target="_blank" rel="noopener"><LineIcon name="chat" size={16} /> WhatsApp</a>
      </div>
    </div>
    <span class="cc-hero__note">placeholder photo — replace with office / workshop</span>
  </section>
  <section class="cc-map">
    <iframe title="Crystal Fit Contracting LLC on Google Maps" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src={site.mapEmbed}></iframe>
    <a class="cc-btn cc-btn--black cc-map__btn" href={site.mapUrl} target="_blank" rel="noopener"><LineIcon name="pin" size={16} /> Get directions</a>
  </section>
  <section class="cc-info">
    <div><LineIcon name="pin" size={26} /><b>Address</b><span>Al Quoz Industrial 3<br />Ghoshi Warehouse City WH-132, Dubai</span></div>
    <div><LineIcon name="phone" size={26} /><b>Phone</b><span><a href={`tel:${site.phoneOffice}`}>+971 4 320 2224</a><br /><a href={site.whatsapp}>{site.phoneMobileDisplay}</a></span></div>
    <div><LineIcon name="mail" size={26} /><b>Email</b><span><a href={`mailto:${site.email}`}>{site.email}</a></span></div>
    <div><LineIcon name="clock" size={26} /><b>Working hours</b><span>Mon – Sat: 09:00 – 18:00<br />Sunday: closed</span></div>
  </section>
  <Logos list={logosInner} />
</Base>
<style is:global>
  .cc-hero { position: relative; height: 560px; overflow: hidden; background: #111; color: #fff; font-family: var(--ff-head); }
  .cc-hero__img { width: 100%; height: 100%; object-fit: cover; }
  .cc-hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(0,0,0,.7), rgba(0,0,0,.2) 60%, rgba(0,0,0,0)); }
  .cc-hero__in { position: absolute; z-index: 1; left: 60px; top: 50%; transform: translateY(-50%); max-width: 560px; }
  .cc-hero h1 { font-size: 54px; line-height: 62px; font-weight: 400; letter-spacing: 3px; text-transform: uppercase; margin: 0 0 18px; }
  .cc-hero p { font-size: 18px; line-height: 28px; font-weight: 300; margin: 0 0 28px; }
  .cc-hero__btns { display: flex; gap: 14px; flex-wrap: wrap; }
  .cc-hero__note { position: absolute; z-index: 1; right: 16px; bottom: 12px; font-size: 12px; background: #ffd400; color: #000; padding: 4px 8px; }
  .cc-btn { display: inline-flex; align-items: center; gap: 8px; padding: 14px 24px; font-family: var(--ff-head); font-size: 13px; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; }
  .cc-btn--white { background: #fff; color: #000; }
  .cc-btn--line { border: 1px solid #fff; color: #fff; }
  .cc-btn--black { background: #000; color: #fff; box-shadow: 0 6px 20px rgba(0,0,0,.25); }
  .cc-map { position: relative; height: 460px; background: #e9e9e9; }
  .cc-map iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .cc-map__btn { position: absolute; left: 50%; bottom: 28px; transform: translateX(-50%); }
  .cc-info { display: grid; grid-template-columns: repeat(4, 1fr); gap: 30px; max-width: 1240px; margin: 0 auto; padding: 60px 40px; font-family: var(--ff-head); }
  .cc-info > div { display: flex; flex-direction: column; gap: 8px; }
  .cc-info b { font-size: 13px; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; color: var(--dark); }
  .cc-info span { font-size: 15px; line-height: 25px; font-weight: 300; color: #333; }
  .cc-info a:hover { text-decoration: underline; }
  @media (max-width: 767px) {
    .cc-hero { height: 520px; }
    .cc-hero__in { left: 16px; right: 16px; top: auto; bottom: 50px; transform: none; }
    .cc-hero h1 { font-size: 32px; line-height: 40px; letter-spacing: 2px; }
    .cc-map { height: 360px; }
    .cc-info { grid-template-columns: 1fr 1fr; padding: 40px 16px; }
  }
</style>
