---
// Service landing pages, content in src/data/services.ts
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import CtaBand from '../components/CtaBand.astro';
import QuickQuote from '../components/QuickQuote.astro';
import '../styles/pages.css';
import Logos from '../components/Logos.astro';
import { services, serviceProcess, type Service } from '../data/services';
import { logosInner } from '../data/site';

export async function getStaticPaths() {
  // live landing pages switched off by owner 2026-11-12 (old /services/ layout kept); URLs 301 -> /services/#section.
  // Only draft references (noindex, not in sitemap/menu) are built.
  return services.filter((s) => s.draft).map((s) => ({ params: { service: s.slug }, props: { s } }));
}
const { s } = Astro.props as { s: Service };
const all = await getCollection('projects', ({ data }) => !data.draft);
const assets = import.meta.glob<{ default: ImageMetadata }>(['../assets/services/*', '../assets/site/*'], { eager: true });
const heroFile = s.heroImage && Object.entries(assets).find(([k]) => k.endsWith('/' + s.heroImage))?.[1].default;
const hero = heroFile || all.find((p) => p.id === s.heroProject)!.data.cover;
const introImg = s.introBlock && Object.entries(assets).find(([k]) => k.endsWith('/' + s.introBlock!.image))?.[1].default;
const pick = (f?: string) => f ? Object.entries(assets).find(([k]) => k.endsWith('/' + f))?.[1].default : undefined;
const deliverImg = pick(s.deliverImage);
// owner's template: after the white intro, blocks alternate black / white
const dBlocks = s.deliverGroups && s.deliverImages
  ? s.deliverGroups.map(([g, items], i) => ({ title: g, items, img: pick(s.deliverImages![i]) }))
  : [{ title: s.heroLines.join(' '), items: s.deliverGroups ? s.deliverGroups.flatMap(([, it]) => it) : s.deliver, img: deliverImg }];
// order (owner 2026-11-16): intro, How we work, one block per service part, approvals, FAQ, latest projects
const dark = (n: number) => n % 2 === 0; // n = position after the intro (0 = How we work, black)
const nS = 0, nD = 1, nA = dBlocks.length + 1, nF = nA + 1, nP = nA + 2;
const apprImg = pick(s.approvalsBlock?.image);
const projects = s.projects.map((id) => all.find((p) => p.id === id)).filter((p) => !!p);
const url = new URL(`/${s.slug}/`, Astro.site).href;
const schema = [
  { '@type': 'Service', name: s.heroLines.join(' '), serviceType: s.heroLines.join(' '), url, description: s.description,
    provider: { '@id': new URL('/#company', Astro.site).href }, areaServed: { '@type': 'City', name: 'Dubai' } },
  { '@type': 'FAQPage', mainEntity: s.faq.filter(([, a]) => !a.includes('[CONFIRM')).map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Services', item: new URL('/services/', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: s.heroLines.join(' '), item: url },
  ] },
];
const hl = (t: string) => t.replace(/\[CONFIRM[^\]]*\]|\[___\]/g, (m) => `<mark>${m}</mark>`);
---
<Base title={s.title} description={s.description} schema={schema} noindex={s.draft} form={!s.draft}>
  {s.draft && <div class="sdraft">DRAFT — not published yet.</div>}
  <Hero slides={[{ image: hero, lines: s.heroLines }]} h1={s.h1} />
  <Breadcrumb current={`Crystal fit contracting LLC / Services / ${s.heroLines.join(' ')}`} />

  {s.introBlock ? (
    <section class="svc svc--light" style="--h:auto">
      <div class="svc__inner">
        <div class="svc__text">
          <p class="svc__kicker">{s.introBlock.kicker}</p>
          <h2 class="svc__title">{s.introBlock.title}</h2>
          {s.introBlock.paras.map((p) => <p set:html={hl(p)} />)}
          <button type="button" class="svc__more" aria-expanded="false">Read more +</button>
        </div>
        <div class="svc__media">{introImg && <Image src={introImg} alt={`${s.introBlock.kicker} by Crystal Fit`} width={500} height={700} widths={[370, 500, 1000]} sizes="(min-width: 768px) 500px, 100vw" fit="cover" loading="lazy" />}</div>
      </div>
    </section>
  ) : (
    <section class="sv">
      <div class="sv__intro">{s.intro.map((p) => <p set:html={hl(p)} />)}</div>
      {s.facts.length > 0 && <ul class="sv__facts">{s.facts.map(([n, t]) => <li><b>{n}</b><span>{t}</span></li>)}</ul>}
    </section>
  )}

{s.approvalsBlock ? (<>
  <!-- How we work: timeline as "Our story" on About -->
  <section class:list={['sv', { 'sv--dark sv--steps': dark(nS) }]}>
    <div class="sv__wrap">
      <h2 class="sv__h2">How we work</h2>
      <ol class="sv__steps">{(s.process ?? serviceProcess).map(([t, d], i) => <li><button type="button" class="sv__step-head" aria-expanded="false" aria-controls={`step-${i}`}><span class="sv__num">Step {String(i + 1).padStart(2, '0')}</span><h3>{t}</h3></button><p id={`step-${i}`}>{d}</p></li>)}</ol>
    </div>
  </section>

  <!-- 2..n. One block per service part ("Interior design: what we deliver", "MEP design: what we deliver"), black/white alternating, photo opposite the text -->
  {dBlocks.map((b, i) => (
    <section class:list={['svc', 'svx', dark(nD + i) ? 'svc--dark' : 'svc--light']}>
      <div class="svc__inner">
        <div class="svc__text">
          <h2 class="svc__title svx__name">{b.title}</h2>
          <p class="svx__sub">What we deliver</p>
          <ul class="sv__list">{b.items.map((d) => <li set:html={hl(d)} />)}</ul>
        </div>
        <div class="svc__media">{b.img && <Image src={b.img} alt={`${b.title} by Crystal Fit`} width={500} height={700} widths={[370, 500, 1000]} sizes="(min-width: 768px) 500px, 100vw" fit="cover" loading="lazy" />}</div>
      </div>
    </section>
  ))}

  <!-- Approvals -->
  <section class:list={['svc', 'svx', dark(nA) ? 'svc--dark' : 'svc--light']}>
    <div class="svc__inner">
      <div class="svc__text">
        <h2 class="svc__title">Which approvals we handle</h2>
        {s.approvalsBlock.paras.map((p) => <p set:html={hl(p)} />)}
        <ul class="svx__tags">{s.approvals.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div class="svc__media">{apprImg && <Image src={apprImg} alt={`Landlord and authority approvals for ${s.heroLines.join(' ')} – Crystal Fit`} width={500} height={700} widths={[370, 500, 1000]} sizes="(min-width: 768px) 500px, 100vw" fit="cover" loading="lazy" />}</div>
    </div>
  </section>

  <!-- FAQ -->
  <section class:list={['sv', { 'sv--dark sv--faqd': dark(nF) }]}>
    <div class="sv__wrap">
    <h2 class="sv__h2">Frequently asked questions</h2>
    <div class="sv__faq">
      {s.faq.map(([q, a]) => <details><summary>{q}</summary><p set:html={hl(a)} /></details>)}
    </div>
    </div>
  </section>

  <!-- Latest projects, then logos + form as on every page -->
  <section class:list={['sv', 'sv--projects', { 'sv--dark': dark(nP) }]}>
    <div class="sv__wrap">
    <h2 class="sv__h2">Latest projects</h2>
    <div class="sv__grid">
      {projects.map((p) => (
        <a class="sv__card" href={`/featured-projects/${p.id}/`}>
          <Image src={p.data.cover} alt={p.data.title} width={640} height={480} widths={[320, 640]} sizes="(min-width: 992px) 25vw, (min-width: 600px) 50vw, 100vw" fit="cover" loading="lazy" quality={72} />
          <span>{p.data.title}</span>
        </a>
      ))}
    </div>
    <p class="sv__more"><a class:list={['btn', dark(nP) ? 'btn--white' : 'btn--black']} href="/portfolio/">View full portfolio</a></p>
    </div>
  </section>
</>) : (<>
  <section class="sv sv--dark">
    <div class="sv__cols">
      <div>
        <h2 class="sv__h2">What we deliver<span class="dot" aria-hidden="true"></span></h2>
        <ul class="sv__list">{s.deliver.map((d) => <li set:html={hl(d)} />)}</ul>
      </div>
      <div>
        <h2 class="sv__h2 sv__appr-h">Approvals we handle</h2>
        <ul class="sv__tags">{s.approvals.map((a) => <li>{a}</li>)}</ul>
        <p class="sv__all">We handle all landlord and authority approvals.</p>
      </div>
    </div>
  </section>
  <section class="sv">
    <h2 class="sv__h2">How we work</h2>
    <ol class="sv__steps">{(s.process ?? serviceProcess).map(([t, d], i) => <li><button type="button" class="sv__step-head" aria-expanded="false" aria-controls={`step-${i}`}><span class="sv__num">Step {String(i + 1).padStart(2, '0')}</span><h3>{t}</h3></button><p id={`step-${i}`}>{d}</p></li>)}</ol>
  </section>
</>)}

  <Logos list={logosInner} />
  {s.draft ? <QuickQuote service={s.heroLines.join(' ')} /> : <CtaBand title="Planning a project?" label="Get a quote" href="#contact-form" />}
</Base>
<script>
  // How we work on phones: tap a step to unfold its text (desktop shows everything)
  document.querySelectorAll<HTMLButtonElement>('.sv__step-head').forEach((b) => b.addEventListener('click', () => {
    if (!matchMedia('(max-width: 991px)').matches) return;
    const open = b.parentElement!.classList.toggle('is-open');
    b.setAttribute('aria-expanded', String(open));
  }));

  document.querySelectorAll<HTMLButtonElement>('.svc__more').forEach((btn) => btn.addEventListener('click', () => {
    const open = btn.parentElement!.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', String(open));
    btn.textContent = open ? 'Read less −' : 'Read more +';
  }));
</script>
<style is:global>
  .sdraft { position: sticky; top: 0; z-index: 50; background: #ffe066; color: #000; text-align: center; font-size: 13px; font-weight: 600; padding: 6px 12px; }
  mark { background: #ffe066; padding: 0 2px; }
  main:has(.sv) .hero__slide::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(0,0,0,.55), rgba(0,0,0,.15) 70%); }
  main:has(.sv) .hero__content { z-index: 1; }
  .sv { max-width: 1260px; margin: 0 auto; padding: 60px 40px; font-family: var(--ff-head); color: #222; }
  .sv--dark { max-width: none; background: #000; color: #fff; }
  .sv--dark > * { max-width: 1180px; margin: 0 auto; }
  .sv--grey { max-width: none; background: #f4f4f4; }
  .sv--grey > * { max-width: 1180px; margin-left: auto; margin-right: auto; }
  .sv__h2 { font-family: var(--ff-head); font-size: var(--fs-h2); line-height: var(--lh-h2); font-weight: 200; letter-spacing: 0; text-transform: uppercase; margin-top: 0; margin-bottom: 30px; }
  .sv__intro p { font-family: var(--ff-head); font-size: var(--fs-lead); line-height: var(--lh-lead); font-weight: 400; letter-spacing: 0; max-width: 900px; margin: 0 0 18px; }
  .sv__facts { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; list-style: none; padding: 0; margin: 40px 0 0; }
  .sv__facts li { border-top: 1px solid #222; padding-top: 14px; }
  .sv__facts b { font-family: var(--ff-head); font-size: var(--fs-stat); line-height: var(--lh-stat); font-weight: 700; letter-spacing: 1px; font-variant-numeric: lining-nums; display: block; }
  .sv__facts span { font-family: var(--ff-head); font-size: var(--fs-body); line-height: var(--lh-body); font-weight: 400; letter-spacing: 0; text-transform: none; color: #666; }
  .sv__cols { display: grid; grid-template-columns: 1.3fr 1fr; gap: 60px; }
  .sv__list { margin: 0; padding: 0; list-style: none; }
  .sv__list li { font-family: var(--ff-head); font-size: var(--fs-body); line-height: var(--lh-body); font-weight: 300; letter-spacing: 0; position: relative; padding: 0 0 14px 24px; color: #edeaea; }
  .sv__list li::before { content: ''; position: absolute; left: 0; top: 11px; width: 8px; height: 8px; background: #fff; border-radius: 50%; }
  .sv__groups { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; }
  .sv__gh { font-family: var(--ff-head); font-size: var(--fs-label); line-height: var(--lh-label); font-weight: 700; letter-spacing: 2px; text-transform: uppercase; margin: 0 0 16px; }
  .sv__tags { display: flex; flex-wrap: wrap; gap: 10px; list-style: none; padding: 0; margin: 0; }
  .sv__all { font-family: var(--ff-head); font-size: var(--fs-label); line-height: var(--lh-label); font-weight: 700; letter-spacing: 2px; text-transform: uppercase; display: none; }
  .sv__tags li { font-family: var(--ff-head); font-size: var(--fs-label); line-height: var(--lh-label); font-weight: 700; letter-spacing: 2px; text-transform: uppercase; border: 1px solid rgba(255,255,255,.5); padding: 8px 14px; }
  /* How we work = same timeline as "Our story" on About (line + dot per step), on white */
  .sv__steps { display: grid; grid-template-columns: repeat(5, 1fr); list-style: none; padding: 0; margin: 20px 0 0; }
  .sv__steps li { position: relative; padding: 34px 30px 0 0; border-top: 1px solid #bbb; }
  .sv__steps li::before { content: ''; position: absolute; left: 0; top: -7px; width: 13px; height: 13px; background: #000; border-radius: 50%; }
  .sv__step-head { all: unset; display: block; width: 100%; box-sizing: border-box; cursor: default; color: inherit; }
  .sv__num { font-family: var(--ff-head); font-size: var(--fs-label); line-height: var(--lh-label); font-weight: 700; letter-spacing: 2px; text-transform: uppercase; display: block; color: #000; margin-bottom: 10px; }
  .sv__steps h3 { font-family: var(--ff-head); font-size: var(--fs-h3); line-height: var(--lh-h3); font-weight: 500; letter-spacing: 1px; text-transform: uppercase; margin: 0 0 12px; }
  .sv__steps p { font-family: var(--ff-head); font-size: var(--fs-body); line-height: var(--lh-body); font-weight: 300; letter-spacing: 0; color: #555; margin: 0; }
  /* owner's template: blocks 2-3 reuse the /services/ .svc layout; lists and tags inside them */
  .svx .svc__text .sv__list li { color: inherit; }
  .svc--light .sv__list li::before { background: #000; }
  .svx .sv__groups { gap: 24px; max-width: 580px; }
  .svx__tags { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 10px; list-style: none; padding: 0; margin: 24px 0 0 auto; max-width: 580px; }
  .svc--dark .svx__tags { justify-content: flex-start; margin-left: 0; }
  .svc--dark .svx__tags li { border-color: rgba(255,255,255,.6); }
  .svc--light .sv__list { max-width: 580px; margin-left: auto; text-align: right; }
  .svc--light .sv__list li { padding: 0 24px 14px 0; }
  .svc--light .sv__list li::before { left: auto; right: 0; }
  @media (max-width: 767px) { .svc--light .sv__list { text-align: left; margin-left: 0; } .svc--light .sv__list li { padding: 0 0 14px 24px; } .svc--light .sv__list li::before { left: 0; right: auto; } }
  .sv--faqd .sv__faq details { border-bottom-color: #333; }
  .sv--faqd .sv__faq p { color: #cfcfcf; }
  .svc__title.svx__name { margin-bottom: 10px; }
  .svc--light.svx .svc__title { padding-right: 0; }
  .svc__text p.svx__sub { font-family: var(--ff-head); font-size: var(--fs-label); line-height: var(--lh-label); font-weight: 700; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 30px; }
  .svx__tags li { font-family: var(--ff-head); font-size: var(--fs-label); line-height: var(--lh-label); font-weight: 700; letter-spacing: 2px; text-transform: uppercase; border: 1px solid #000; padding: 8px 14px; }
  .sv__wrap { max-width: 1180px; margin: 0 auto; }
  /* steps on black = exact "Our story" colours */
  .sv--steps .sv__steps li { border-top-color: #555; }
  .sv--steps .sv__steps li::before { background: #fff; }
  .sv--steps .sv__num { color: #fff; }
  .sv--steps .sv__steps p { color: #cfcfcf; }
  .sv__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .sv__card img { width: 100%; height: auto; aspect-ratio: 4/3; object-fit: cover; display: block; }
  .sv__card span { font-family: var(--ff-head); font-size: var(--fs-card); line-height: var(--lh-card); font-weight: 600; letter-spacing: 1px; text-transform: uppercase; display: block; padding: 12px 0 0; color: #222; }
  .sv__more { text-align: center; margin-top: 40px; margin-bottom: 0; }
  .sv--projects { border-top: 0; }
  .sv--dark .sv__card span { color: #fff; }
  .sv__faq details { border-bottom: 1px solid #ddd; padding: 16px 0; }
  .sv__faq summary { font-family: var(--ff-head); font-size: var(--fs-q); line-height: var(--lh-q); font-weight: 500; letter-spacing: 0; cursor: pointer; list-style: none; }
  .sv__faq summary::after { content: '+'; float: right; font-weight: 300; }
  .sv__faq details[open] summary::after { content: '–'; }
  .sv__faq p { font-family: var(--ff-head); font-size: var(--fs-body); line-height: var(--lh-body); font-weight: 300; letter-spacing: 0; margin: 12px 0 0; max-width: 950px; }
  @media (max-width: 1100px) and (min-width: 992px) { .sv__steps { grid-template-columns: repeat(3, 1fr); row-gap: 40px; } }
  @media (max-width: 991px) {
    .sv { padding: 44px 16px; }


    .sv__facts { grid-template-columns: repeat(2, 1fr); }
    .sv__cols { grid-template-columns: 1fr; gap: 20px; }
    .sv__groups { grid-template-columns: 1fr; gap: 10px; }
    .sv__appr-h, .sv__tags { display: none; }
    .sv__all { display: block; margin: 0; font-weight: 600; text-transform: uppercase; }
    /* phone: vertical line, each step = a line (number + title); tap to unfold the text — as "Our story" */
    .sv__steps { grid-template-columns: 1fr; border-left: 1px solid #bbb; margin-left: 6px; }
    .sv__steps li { border-top: 0; padding: 0 0 0 26px; border-bottom: 1px solid #e3e3e3; }
    .sv__steps li::before { left: -7px; top: 18px; }
    .sv__step-head { cursor: pointer; padding: 14px 30px 14px 0 !important; position: relative; }
    .sv__step-head::after { content: '+'; position: absolute; right: 4px; top: 50%; transform: translateY(-50%); font: 300 24px/1 var(--ff-head); color: #000; transition: transform .2s; }
    .sv__steps li.is-open .sv__step-head::after { transform: translateY(-50%) rotate(45deg); }
    .sv__steps h3 { margin: 0; }
    .sv--steps .sv__steps { border-left-color: #555; }
    .sv--steps .sv__steps li { border-bottom-color: #333; }
    .sv--steps .sv__step-head::after { color: #fff; }
    .svx__tags { justify-content: flex-start; margin-left: 0; }
    .sv__steps p { display: none; padding: 0 0 18px; }
    .sv__steps li.is-open p { display: block; }
    .sv__grid { grid-template-columns: repeat(2, 1fr); gap: 14px; }
  }
  @media (max-width: 599px) { .sv__grid { grid-template-columns: 1fr; } }
</style>
