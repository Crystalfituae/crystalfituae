---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import CtaBand from '../components/CtaBand.astro';
import Logos from '../components/Logos.astro';
import { logosInner } from '../data/site';
import '../styles/pages.css';
import hero from '../assets/site/hero-services.jpg';
import retail from '../assets/services/retail.jpg';
import fnb from '../assets/services/fnb.jpg';
import residential from '../assets/services/residential.jpg';
import planning from '../assets/services/planning.jpg';

const blocks = [
  { dark: true, img: fnb, title: 'Food & Beverage (F&B)', href: '/cafe-restaurant-fit-out-dubai/', paras: [
    'Opening a new Food &amp; Beverage (F&amp;B) venue in the UAE is a long and thrilling journey. Strict timelines, specified vendors, landlord obligations, design codes and fines are what your first site meeting will mostly sound like.',
    'Business in Dubai does not forgive mistakes — this is where an experienced design &amp; build team comes first. Since 2014 we have delivered cafes, coffee shops and restaurants in the major Dubai locations and worked with most landlords: Emaar, Nakheel, Dubai Holding, Trakhees, The Dubai Mall, Dubai Hills, Circle Mall, The Pointe and more.',
    'Our strength is not only design aesthetics but procedure know-how: we are prequalified with the main vendors and registered with all government entities, ready to be your reliable partner on the way to a successful food concept.'] },
  { dark: false, img: retail, title: 'Commercial', href: '/commercial-fit-out-dubai/', paras: [
    'Our commercial interiors — offices, retail, clinics and showrooms — always start with a deep analysis of your business, customers and their behaviour. We create a memorable image of your brand, both aesthetically and functionally, with efficient zoning, styling and decor.',
    'We know the government approval processes and have a proven track record in the major malls and business districts of the UAE: The Dubai Mall, Mall of the Emirates, Nakheel Mall, Marina Mall, JBR, Bluewaters, DIFC and Bay Square.',
    'Hire a professional team with vast experience and make sure you meet your handover deadlines.'] },
  { dark: true, img: residential, title: 'Residential', href: '/villa-interior-design-dubai/', paras: [
    'Residential interiors have always been a core part of our services. We create well-thought, bespoke designs for you to call home — perfectly balanced space planning combined with experience-based design solutions for concentration, revival and retreat.',
    'Crystal Fit develops the interior, handles all documentation and approvals, procurement, construction timelines, quality and budget on your behalf. Sit back, relax and move in to a tailor-made interior of your dreams.'] },
  { dark: false, img: planning, title: 'Design & Consultancy', href: '/interior-design-consultancy-dubai/', paras: [
    'If you don’t think about space planning in daily life, your space is well planned. Our bespoke space planning, ergonomics and technical consultancy maximise the potential and efficiency of every square metre, bringing form and function together.',
    'Since 2014 we have mastered construction project management and turnkey project handling. We coordinate architects, designers, contractors, authorities and all stakeholders, solving issues early and delivering the highest quality — on time.'] },
];
---
<Base title="Interior Design & Fit-Out Services in Dubai | Crystal Fit" description="Restaurant, cafe, office and retail fit-out, villa interiors and turnkey project management in Dubai, with Emaar, Dubai Holding, TECOM & Nakheel approvals.">
  <Hero slides={[{ image: hero, lines: ['Our', 'Services'] }]} place="right-top" dark h1="— interior design & fit-out in Dubai" />
  <Breadcrumb current="Crystal fit contracting LLC UAE / SERVICES" />
  {blocks.map((b) => (
    <section class:list={['svc', b.dark ? 'svc--dark' : 'svc--light']}>
      <div class="svc__inner">
        <div class="svc__text">
          <h2 class="svc__title"><a href={b.href}>{b.title}</a>{b.dark && <span class="dot" aria-hidden="true"></span>}</h2>
          {b.paras.map((p) => <p set:html={p} />)}
          <a class:list={['btn', b.dark ? 'btn--white' : 'btn--black', 'svc__more']} href={b.href}>Learn more</a>
        </div>
        <div class="svc__media"><Image src={b.img} alt={`${b.title} fit-out by Crystal Fit`} width={500} height={700} widths={[370, 500, 1000]} sizes="(min-width: 768px) 500px, 100vw" fit="cover" loading="lazy" /></div>
      </div>
    </section>
  ))}
  <Logos list={logosInner} />
  <CtaBand title="still having questions ?" label="Contact us" href="/contact/" />
</Base>
<style>
  .svc__title a { color: inherit; }
  .svc__more { margin-top: 14px; }
</style>
