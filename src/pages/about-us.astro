---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CtaBand from '../components/CtaBand.astro';
import Logos from '../components/Logos.astro';
import { logosInner } from '../data/site';
import '../styles/pages.css';
import hero from '../assets/site/hero-about.jpg';
import office from '../assets/about/office.jpg';

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/about/team-*.jpg', { eager: true });
const ph = (n: string) => photos[`../assets/about/team-${n}.jpg`].default;
const team = [
  ['alina', 'Alina D.', 'Business Development Manager'], ['vignesh', 'Vignesh V.', 'MEP PROJECT MANAGER'], ['vladimir', 'Vladimir H.', 'Project Manager'],
  ['apple', 'Apple C.', 'Administrator'], ['abishikth', 'Abishikth', 'Head of Accounts'], ['gerin', 'Gerin K.', 'Designer'], ['thejus', 'Thejus T.', 'Designer'],
  ['dhanesh', 'Dhanesh T.', '3D visualizer'], ['saba', 'Saba F.', 'Designer'], ['stepan', 'Stepan R.', 'Site Coordinator'],
];
const checks = [
  ['Proven Expertise', '– 200+ projects successfully delivered in Dubai since 2014.'],
  ['One-Stop Solution', '– Integrated design, project management, approvals, and execution under one roof.'],
  ['Time & Quality Commitment', '– Adherence to deadlines with uncompromised finishing standards.'],
  ['Tailored Approach', '– Every project is customized to reflect client’s brand, vision, and operational needs.'],
  ['Trusted Network', '– Partnerships with reliable suppliers, contractors, and manufacturers worldwide.'],
  ['Cost Transparency', '– Clear budgeting and proactive value engineering.'],
];
---
<Base title="About Crystal Fit – Design & Build Fit-Out Team, Dubai" description="Dubai design & build fit-out team since 2014: 200+ projects for Roasters, Christie's, Mercure and Shangri-La. Approved by Emaar and Dubai Holding.">
  <Hero slides={[{ image: hero, lines: ['Who we', 'are'] }]} place="right-top" dark h1="— about Crystal Fit Contracting LLC" />
  <div class="hero-gap"></div>
  <section class="about">
    <div class="about__text">
      <p><br />Crystal Fit Contracting LLC is a Dubai-based design &amp; build studio operating across the GCC and MENA region since 2014.</p>
      <p>&nbsp;</p>
      <p>With over a decade of expertise in the local interior fit-out market, we provide a one-stop solution for clients in the Commercial, HoReCa (Hotels, Restaurants, Cafés), Residential, and Public sectors — delivering projects that prioritize time, quality, and a bespoke business approach.</p>
      <p>Our portfolio features 200+ successfully completed projects across Dubai, reflecting our ability to transform spaces into inspiring, functional, and brand-driven environments.</p>
      <p>At Crystal Fit, we are selective with our approaches, suppliers, and contractors to ensure the highest quality standards, making us a trusted partner for businesses and individuals alike.</p>
      <p>Let’s elevate your spaces — enhancing both lifestyle and business success — with our professional design &amp; build services.</p>
      <p>&nbsp;</p>
      <ul class="about__checks">
        {checks.map(([b, t]) => <li><span class="chk" aria-hidden="true">✅</span><strong>{b}</strong> {t}</li>)}
        <li><span class="chk" aria-hidden="true">✅</span><strong>Long-Term Partnership</strong> – We aim to be not just a contractor, but a <strong>strategic partner in your growth</strong>.</li>
      </ul>
    </div>
    <div class="about__media">
      <Image src={office} alt="Crystal Fit office" widths={[475, 950]} sizes="475px" loading="lazy" />
    </div>
  </section>

  <section class="team">
    <h2 class="team__title">TEAM</h2>
    <figure class="team__lead">
      <Image src={ph('konstantin')} alt="Konstantin Grytsan" width={487} height={487} widths={[487, 974]} sizes="(min-width: 768px) 487px, 100vw" fit="cover" loading="lazy" />
      <figcaption><b>KONSTANTIN GRYTSAN</b><span>CEO / FOUNDER</span></figcaption>
    </figure>
    <div class="team__grid">
      {team.map(([k, n, r]) => (
        <figure>
          <Image src={ph(k)} alt={n} width={254} height={254} widths={[254, 508]} sizes="(min-width: 768px) 254px, 50vw" fit="cover" loading="lazy" />
          <figcaption><b>{n}</b><span>{r}</span></figcaption>
        </figure>
      ))}
    </div>
  </section>

  <CtaBand title="LETS GROW TOGETHER" label="APPLY NOW" href="/contact/" />
  <Logos list={logosInner} />
</Base>
