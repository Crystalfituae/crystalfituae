---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CtaBand from '../components/CtaBand.astro';
import Logos from '../components/Logos.astro';
import LineIcon from '../components/LineIcon.astro';
import { logosInner } from '../data/site';
import '../styles/pages.css';
import hero from '../assets/site/hero-about.jpg';
import heroOffice from '../assets/about/hero-office.jpg';

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/about/team-*.jpg', { eager: true });
const ph = (n: string) => photos[`../assets/about/team-${n}.jpg`].default;
const team = [
  ['alina', 'Alina D.', 'Business Development Manager'], ['vignesh', 'Vignesh V.', 'MEP Project Manager'], ['vladimir', 'Vladimir H.', 'Project Manager'],
  ['apple', 'Apple C.', 'Administrator'], ['abishikth', 'Abishikth', 'Head of Accounts'], ['gerin', 'Gerin K.', 'Designer'], ['thejus', 'Thejus T.', 'Designer'],
  ['dhanesh', 'Dhanesh T.', '3D Visualizer'], ['saba', 'Saba F.', 'Designer'], ['stepan', 'Stepan R.', 'Site Coordinator'],
];
const why: [string, string, string][] = [
  ['award', '200+ projects', 'Delivered in Dubai and the UAE since 2014'],
  ['layers', 'One-stop', 'Design, approvals and build under one roof'],
  ['shield', 'Approvals', 'Emaar, Dubai Holding, TECOM, Nakheel, DM, DCD'],
  ['clock', 'On time', 'Programmes we keep, finishes we don’t compromise'],
  ['calc', 'Transparent', 'Detailed BOQs and value engineering'],
  ['growth', 'Partnership', 'A long-term partner, not just a contractor'],
];
const units: [string, string][] = [
  ['pen', 'Interior design'], ['cube', '3D visualisation'], ['ruler', 'Technical drawings'],
  ['bolt', 'MEP engineering'], ['clipboard', 'Project management'], ['helmet', 'Site supervision'],
];
const schema = [{ '@type': 'AboutPage', name: 'About Crystal Fit Contracting LLC', url: new URL('/about-us/', Astro.site).href,
  mainEntity: { '@id': new URL('/#company', Astro.site).href } },
  { '@type': 'Person', name: 'Konstantin Grytsan', jobTitle: 'CEO & Founder', worksFor: { '@id': new URL('/#company', Astro.site).href } }];
---
<Base title="About Crystal Fit – Design & Build Fit-Out Team, Dubai" description="Dubai design & build fit-out team since 2014: 200+ projects for Roasters, Christie's, Mercure and Shangri-La. Approved by Emaar and Dubai Holding." schema={schema}>
  <Hero slides={[{ image: heroOffice, lines: ['Who we', 'are'] }]} dark h1="— about Crystal Fit Contracting LLC, design & build fit-out company in Dubai" />
  <section class="ab">
    <div class="ab__intro">
      <p class="ab__lead">Dubai design &amp; build fit-out company since 2014.</p>
      <p>We design, approve and build Food &amp; Beverage (F&amp;B), commercial and residential interiors across the UAE — with one in-house team from the first sketch to handover.</p>
      <p class="ab__brands">Roasters · WALA · Christie’s · YOY at Shangri-La · Mercure · AMV Clinic</p>
    </div>
    <ul class="ab__nums">
      <li><b>200+</b><span>projects</span></li><li><b>10+</b><span>years in UAE</span></li><li><b>1</b><span>team, design to handover</span></li><li><b>1 year</b><span>warranty</span></li>
    </ul>
  </section>

  <section class="ab-why">
    <h2 class="ab-h2">Why Crystal Fit</h2>
    <ul class="ab-why__grid">{why.map(([i, t, d]) => <li><LineIcon name={i} size={32} stroke={1.3} /><h3>{t}</h3><p>{d}</p></li>)}</ul>
  </section>

  <section class="ab-units">
    <h2 class="ab-h2">In-house team</h2>
    <ul>{units.map(([i, t]) => <li><LineIcon name={i} size={30} stroke={1.3} /><span>{t}</span></li>)}</ul>
  </section>

  <section class="team">
    <h2 class="team__title">Team</h2>
    <div class="team__lead">
      <figure>
        <Image src={ph('konstantin')} alt="Konstantin Grytsan, CEO and founder of Crystal Fit" width={487} height={487} widths={[487, 974]} sizes="(min-width: 768px) 487px, 100vw" fit="cover" loading="lazy" />
        <figcaption><b>Konstantin Grytsan</b><span>CEO / Founder</span></figcaption>
      </figure>
      <div class="team__bio">
        <p class="team__quote">“One team, one promise: spaces that work for the business behind them.”</p>
        <p>Founder of Crystal Fit (2014). From a small design studio to a full design &amp; build contractor with 200+ projects — from specialty coffee chains to Christie’s, Mercure and private villas.</p>
        <p>Personally leads every project, from the first concept to handover.</p>
      </div>
    </div>
    <div class="team__grid">
      {team.map(([k, n, r]) => (
        <figure>
          <Image src={ph(k)} alt={`${n}, ${r} at Crystal Fit`} width={254} height={254} widths={[254, 508]} sizes="(min-width: 1200px) 254px, (min-width: 768px) 30vw, 50vw" fit="cover" loading="lazy" />
          <figcaption><b>{n}</b><span>{r}</span></figcaption>
        </figure>
      ))}
    </div>
  </section>

  <CtaBand title="LETS GROW TOGETHER" label="APPLY NOW" href="/contact/?topic=recruitment#contact-form" />
  <Logos list={logosInner} />
</Base>
<style is:global>
  .ab { background: #000; color: #fff; font-family: var(--ff-head); display: grid; grid-template-columns: 1.4fr 1fr; gap: 60px; padding: 70px max(40px, calc((100% - 1270px) / 2)); align-items: center; }
  .ab__intro .ab__lead { font-size: 32px; line-height: 42px; font-weight: 400; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 20px; }
  .ab__intro p { font-size: 18px; line-height: 30px; font-weight: 300; color: #ddd; margin: 0 0 18px; max-width: 640px; }
  .ab__intro .ab__lead { color: #fff; }
  .ab__brands { font-size: 13px !important; letter-spacing: 2px; text-transform: uppercase; color: #999 !important; }
  .ab__nums { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 34px 20px; }
  .ab__nums li { border-top: 1px solid #333; padding-top: 14px; }
  .ab__nums b { display: block; font-size: 44px; line-height: 1.1; font-weight: 300; }
  .ab__nums span { font-size: 13px; letter-spacing: 1.5px; text-transform: uppercase; color: #aaa; }
  .ab-h2 { font-family: var(--ff-head); font-size: 26px; line-height: 32px; font-weight: 700; letter-spacing: .5px; text-transform: uppercase; color: #000; margin: 0 0 30px; }
  .ab-why, .ab-units { max-width: 1350px; margin: 0 auto; padding: 60px 40px 10px; font-family: var(--ff-head); }
  .ab-why__grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(6, 1fr); gap: 26px; }
  .ab-why__grid li { color: #000; }
  .ab-why__grid h3 { font-size: 16px; line-height: 22px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; margin: 14px 0 6px; }
  .ab-why__grid p { font-size: 14px; line-height: 21px; color: #555; margin: 0; }
  .ab-units ul { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(6, 1fr); gap: 16px; }
  .ab-units li { display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 22px 10px; border: 1px solid #e5e5e5; text-align: center; color: #000; }
  .ab-units span { font-size: 13px; line-height: 18px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; }
  @media (max-width: 1100px) { .ab { grid-template-columns: 1fr; gap: 40px; } .ab-why__grid, .ab-units ul { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 767px) { .ab { padding: 40px 16px; } .ab__intro .ab__lead { font-size: 24px; line-height: 32px; } .ab__nums b { font-size: 34px; } .ab-why, .ab-units { padding: 40px 16px 0; } .ab-why__grid { grid-template-columns: repeat(2, 1fr); } .ab-units ul { grid-template-columns: repeat(2, 1fr); } }
  .team { max-width: 1350px; margin: 0 auto; padding: 60px 40px 30px; }
  .team__title { font-family: var(--ff-head); font-size: 26px; line-height: 32px; font-weight: 700; letter-spacing: .5px; text-transform: uppercase; color: #000; margin: 0 0 30px; }
  .team__lead { display: grid; grid-template-columns: 487px 1fr; gap: 60px; align-items: center; width: auto; margin: 0 0 40px !important; }
  .team__lead figure { margin: 0; }
  .team__lead img { width: 487px; height: 487px; object-fit: cover; display: block; }
  .team__bio { font-family: var(--ff-head); font-size: 17px; line-height: 29px; font-weight: 300; color: #333; max-width: 560px; }
  .team__bio p { margin: 0 0 14px; }
  .team__quote { font-size: 24px; line-height: 36px; font-weight: 400; font-style: italic; color: #000; border-left: 2px solid #000; padding-left: 20px; margin-bottom: 24px !important; }
  .team figure { margin: 0; }
  .team figcaption { padding-top: 16px; color: #000; font-family: var(--ff-head); text-transform: uppercase; }
  .team figcaption b { display: block; font-size: 14px; line-height: 21px; font-weight: 700; letter-spacing: .5px; }
  .team figcaption span { display: block; font-size: 12px; line-height: 21px; font-weight: 400; color: #555; }
  .team__grid { display: grid; grid-template-columns: repeat(5, 1fr); column-gap: 20px; row-gap: 26px; padding: 0; }
  .team__grid img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; display: block; }
  @media (max-width: 1100px) {
    .team__lead { grid-template-columns: 1fr 1fr; gap: 36px; }
    .team__lead img { width: 100%; height: auto; aspect-ratio: 1; }
    .team__grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 767px) {
    .team { padding: 30px 16px 20px; }
    .team__title { margin: 0 0 20px; }
    .team__lead { grid-template-columns: 1fr; gap: 22px; margin: 0 0 30px !important; }
    .team__bio { font-size: 16px; line-height: 27px; }
    .team__quote { font-size: 19px; line-height: 29px; }
    .team__grid { grid-template-columns: repeat(2, 1fr); column-gap: 12px; }
  }
</style>
