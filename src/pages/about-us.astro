---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CtaBand from '../components/CtaBand.astro';
import Logos from '../components/Logos.astro';
import LineIcon from '../components/LineIcon.astro';
import { logosInner } from '../data/site';
import '../styles/pages.css';
import hero from '../assets/site/hero-about.jpg';
import builder from '../assets/about/builder-back.jpg';

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/about/team-*.jpg', { eager: true });
const ph = (n: string) => photos[`../assets/about/team-${n}.jpg`].default;
// [photo key or '' if no photo yet, name, role] — 6 per row
const team = [
  ['alina', 'Alina D.', 'Business Development Manager'], ['vladimir', 'Vladimir H.', 'Project Manager'], ['', 'Kiranraj', 'MEP Engineer'],
  ['', 'Alam', 'Site Foreman'], ['', 'Hema', 'Document Controller'], ['', 'Athira', 'Office Administrator'],
  ['gerin', 'Gerin K.', 'Designer'], ['thejus', 'Thejus T.', 'Designer'], ['', 'Sofia', 'Designer'],
  ['saba', 'Saba F.', 'Procurement Designer'], ['dhanesh', 'Dhanesh T.', '3D Visualizer'], ['abishikth', 'Abishikth', 'Head of Accounts'],
];
const initials = (n: string) => n.replace(/\./g, '').split(' ').map((w) => w[0]).join('').slice(0, 2).toUpperCase();
const why: [string, string, string][] = [
  ['award', 'Proven expertise', '200+ fit-out projects delivered in Dubai and the UAE since 2014.'],
  ['layers', 'One-stop solution', 'Design, approvals, MEP, construction and project management under one roof.'],
  ['shield', 'Approvals know-how', 'Landlord and authority approvals with Emaar, Dubai Holding, TECOM, Nakheel, DM, DCD and DEWA.'],
  ['clock', 'Time & quality', 'Programmes we keep and finishing standards we don’t compromise.'],
  ['target', 'Tailored approach', 'Every space reflects the client’s brand, vision and the way the business operates.'],
  ['calc', 'Cost transparency', 'Detailed BOQs, clear budgets and proactive value engineering.'],
  ['network', 'Trusted network', 'Long-term partners: specialist subcontractors, suppliers and manufacturers.'],
  ['growth', 'Long-term partnership', 'Not just a contractor — a strategic partner in your growth.'],
];
// numbers from the owner (2026-11-12)
const facts: [string, string][] = [['200+', 'Projects completed'], ['38', 'Projects in Emaar properties'], ['58', 'Projects with Dubai Holding'], ['10', 'Projects in TECOM']];

// Our story: milestones
const story: [string, string, string][] = [
  ['Before 2014', 'The search', 'Konstantin Grytsan works around the world as a lead designer and architect — business parks and hotels in Berlin and Moscow, a private palace in Doha. Again and again he struggles to find builders who understand a designer’s idea, take real responsibility for the result and have an eye for beauty in the details.'],
  ['2014', 'Crystal Fit is founded', 'Konstantin opens Crystal Fit in Dubai as a design studio: concepts, 3D visualisation and technical drawings for cafes, offices and homes.'],
  ['Growth', 'From design to build', 'Clients ask us to build what we design. Step by step the studio grows into a full in-house fit-out team — project managers, MEP engineers, site foremen and our own builders.'],
  ['Today', 'One team, sketch to handover', '200+ completed projects for Roasters, WALA, Christie’s, Mercure and private clients, delivered under the requirements of Emaar, Dubai Holding and TECOM.'],
];

const schema = [{ '@type': 'AboutPage', name: 'About Crystal Fit Contracting LLC', url: new URL('/about-us/', Astro.site).href,
  mainEntity: { '@id': new URL('/#company', Astro.site).href } },
  { '@type': 'Person', name: 'Konstantin Grytsan', jobTitle: 'CEO & Founder', worksFor: { '@id': new URL('/#company', Astro.site).href }, alumniOf: 'Heriot-Watt University', sameAs: ['https://www.linkedin.com/in/konstantin-grytsan-1082a968/'] }];
---
<Base title="About Crystal Fit – Design & Build Fit-Out Team, Dubai" description="Dubai design & build fit-out team since 2014: 200+ projects for Roasters, Christie's, Mercure and Shangri-La. Approved by Emaar and Dubai Holding." schema={schema}>
  <Hero slides={[{ image: hero, lines: ['Who we', 'are'] }]} place="right-top" dark h1="— about Crystal Fit Contracting LLC, design & build fit-out company in Dubai" />

  <!-- 1. About us text + builder photo (white) -->
  <section class="ab-intro">
    <div class="ab-intro__text">
      <p class="ab-lead"><strong>Crystal Fit Contracting LLC</strong> is a Dubai design &amp; build company that takes a space from the first sketch to opening day — with its own designers, engineers, project managers and builders.</p>
      <p>Since 2014 we have delivered <strong>200+ projects</strong> across the UAE: specialty coffee shops and restaurants, offices, clinics, galleries, hotels and private villas. Design, landlord and authority approvals, MEP, joinery and fit-out are handled by one in-house team — so the space you approve on the render is the space you get on site.</p>
      <p>We are known for attention to detail, transparent BOQs and programmes we keep. Every project is led personally from concept to handover.</p>
      <ul class="about__why">
        {why.map(([i, t, d]) => <li><LineIcon name={i} size={26} class="about__ico" /><div><strong>{t}</strong><span>{d}</span></div></li>)}
      </ul>
    </div>
    <div class="ab-intro__media">
      <Image src={builder} alt="Crystal Fit builder pointing at the company logo on his T-shirt" widths={[480, 960]} sizes="(min-width: 992px) 40vw, 100vw" loading="lazy" quality={75} />
    </div>
  </section>

  <!-- 2. Our story: milestones + key numbers (black) -->
  <section class="ab-story">
    <h2 class="ab-title">Our story</h2>
    <ol class="ab-miles">
      {story.map(([when, t, d]) => <li><span class="ab-miles__when">{when}</span><h3>{t}</h3><p>{d}</p></li>)}
    </ol>
    <div class="ab-nums">
      {facts.map(([n, t]) => <div><b>{n}</b><span>{t}</span></div>)}
    </div>
  </section>

  <!-- 3. Message from the CEO (white) -->
  <section class="team team--ceo">
    <div class="team__lead">
      <figure>
        <Image src={ph('konstantin')} alt="Konstantin Grytsan, CEO and founder of Crystal Fit" width={487} height={487} widths={[487, 974]} sizes="(min-width: 768px) 487px, 100vw" fit="cover" loading="lazy" />
        <figcaption><b>Konstantin Grytsan</b><span>CEO / Founder</span></figcaption>
      </figure>
      <div class="team__bio">
        <p class="ab-kicker">Message from the CEO</p>
        <p class="team__quote">“Design is a promise. Our job is to keep it — in every joint, every detail and every deadline.”</p>
        <p>Architect and project manager. Before Crystal Fit, Konstantin designed and led business parks, hotels and mixed-use towers in Berlin and Moscow and a 12,000 sqm private palace in Doha. In 2014 he founded Crystal Fit in Dubai — today a design &amp; build team with 200+ completed projects, from Roasters and WALA to Christie’s and Mercure Gold Hotel.</p>
        <ul class="team__mottos">
          <li>Beautiful is not enough — a space has to work for the business behind it.</li>
          <li>One team, one responsibility: from the first sketch to the last detail.</li>
          <li>We hand over only what we are proud to sign.</li>
        </ul>
        <p class="team__creds">Heriot-Watt University, Project Management · Certified ARCHICAD &amp; AutoCAD specialist · <a href="https://www.linkedin.com/in/konstantin-grytsan-1082a968/" target="_blank" rel="noopener">LinkedIn</a></p>
      </div>
    </div>
  </section>

  <!-- 4. Team behind the magic (white header) -->
  <section class="ab-band"><h2 class="ab-title">Team behind the magic</h2></section>

  <!-- 5. Team photos, 6 per row (black) -->
  <section class="ab-team">
    <div class="team__grid">
      {team.map(([k, n, r]) => (
        <figure>
          {k ? <Image src={ph(k)} alt={`${n}, ${r} at Crystal Fit`} width={254} height={254} widths={[254, 508]} sizes="(min-width: 1200px) 200px, (min-width: 768px) 30vw, 50vw" fit="cover" loading="lazy" />
             : <div class="team__ph" aria-hidden="true">{initials(n)}</div>}
          <figcaption><b>{n}</b><span>{r}</span></figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- 6. Lets grow together (white), logos (black), form (white), footer (black) -->
  <CtaBand title="LETS GROW TOGETHER" label="APPLY NOW" href="/contact/?topic=recruitment#contact-form" />
  <Logos list={logosInner} />
</Base>
<style is:global>
  /* About page: black / white sections only, alternating */
  .ab-title { font-family: var(--ff-head); font-size: 72px; line-height: 80px; font-weight: 200; text-transform: uppercase; margin: 0; }
  .ab-intro { background: #fff; color: #000; max-width: 1350px; margin: 0 auto; display: grid; grid-template-columns: 1fr 40%; gap: 60px; align-items: center; padding: 70px 40px; font-family: var(--ff-head); font-size: 17px; line-height: 30px; font-weight: 300; }
  .ab-intro p { margin: 0 0 16px; color: #333; }
  .ab-intro p strong { font-weight: 600; color: #000; }
  .ab-lead { font-size: 21px !important; line-height: 34px !important; color: #000 !important; }
  .ab-intro .about__ico { color: #000; }
  .ab-intro .about__why strong { color: #000; }
  .ab-intro .about__why span { color: #555; }
  .ab-intro__media img { width: 100%; height: auto; aspect-ratio: 4/5; object-fit: cover; display: block; }

  .ab-story { background: #000; color: #fff; padding: 80px 40px; font-family: var(--ff-head); }
  .ab-story > * { max-width: 1270px; margin-left: auto; margin-right: auto; }
  .ab-story .ab-title { margin-bottom: 50px; }
  .ab-miles { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 0; margin-bottom: 70px; }
  .ab-miles li { position: relative; padding: 34px 30px 0 0; border-top: 1px solid #555; }
  .ab-miles li::before { content: ''; position: absolute; left: 0; top: -7px; width: 13px; height: 13px; background: #fff; border-radius: 50%; }
  .ab-miles__when { display: block; font-size: 15px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: #fff; margin-bottom: 10px; }
  .ab-miles h3 { font-size: 20px; line-height: 28px; font-weight: 500; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 12px; }
  .ab-miles p { font-size: 16px; line-height: 27px; font-weight: 300; color: #cfcfcf; margin: 0; }
  .ab-nums { display: grid; grid-template-columns: repeat(4, 1fr); text-align: center; gap: 20px; border-top: 1px solid #333; padding-top: 60px; }
  .ab-nums b { display: block; font-size: 62px; line-height: 1.1; font-weight: 800; letter-spacing: 4px; font-variant-numeric: lining-nums; margin-bottom: 10px; }
  .ab-nums span { display: block; font-size: 14px; letter-spacing: 3px; text-transform: uppercase; font-weight: 700; color: #ddd; }

  .team { max-width: 1350px; margin: 0 auto; padding-left: 40px; padding-right: 40px; }
  .team--ceo { background: #fff; padding-top: 80px; padding-bottom: 40px; }
  .team__lead { display: grid; grid-template-columns: 487px 1fr; gap: 60px; align-items: center; }
  .team__lead figure { margin: 0; }
  .team__lead img { width: 487px; height: 487px; object-fit: cover; display: block; }
  .team__lead figcaption { padding-top: 16px; color: #000; font-family: var(--ff-head); text-transform: uppercase; }
  .team__lead figcaption b { display: block; font-size: 14px; line-height: 21px; font-weight: 700; letter-spacing: .5px; }
  .team__lead figcaption span { display: block; font-size: 12px; line-height: 21px; color: #555; }
  .team__bio { font-family: var(--ff-head); font-size: 17px; line-height: 29px; font-weight: 300; color: #333; max-width: 640px; }
  .team__bio p { margin: 0 0 16px; }
  .ab-kicker { font-size: 14px !important; letter-spacing: 3px; text-transform: uppercase; font-weight: 700; color: #000; margin-bottom: 18px !important; }
  .team__quote { font-size: 22px; line-height: 34px; font-weight: 400; font-style: italic; color: #000; border-left: 2px solid #000; padding-left: 20px; margin-bottom: 26px !important; }
  .team__mottos { list-style: none; margin: 0 0 18px; padding: 0; }
  .team__mottos li { position: relative; padding-left: 18px; margin-bottom: 8px; font-weight: 500; color: #000; }
  .team__mottos li::before { content: ''; position: absolute; left: 0; top: 12px; width: 7px; height: 7px; background: #000; }
  .team__creds { font-size: 13px !important; line-height: 21px !important; letter-spacing: 1px; text-transform: uppercase; color: #777; }
  .team__creds a { color: #000; text-decoration: underline; }

  .ab-band { background: #fff; color: #000; padding: 50px 20px 60px; text-align: center; }
  .ab-team { background: #000; padding: 70px 40px; }
  .ab-team .team__grid { max-width: 1270px; margin: 0 auto; display: grid; grid-template-columns: repeat(6, 1fr); column-gap: 20px; row-gap: 30px; padding: 0; }
  .ab-team figure { margin: 0; }
  .ab-team img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; display: block; }
  .ab-team figcaption { padding-top: 14px; color: #fff; font-family: var(--ff-head); text-transform: uppercase; }
  .ab-team figcaption b { display: block; font-size: 14px; line-height: 21px; font-weight: 700; letter-spacing: .5px; }
  .ab-team figcaption span { display: block; font-size: 12px; line-height: 19px; color: #aaa; }
  .team__ph { aspect-ratio: 1; background: #1c1c1c; display: flex; align-items: center; justify-content: center; font-family: var(--ff-head); font-size: 40px; font-weight: 200; letter-spacing: 3px; color: #666; }

  .about__why { list-style: none; margin: 34px 0 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 22px 34px; }
  .about__why li { display: flex; gap: 14px; align-items: flex-start; }
  .about__ico { flex: 0 0 auto; margin-top: 3px; }
  .about__why strong { display: block; font-size: 15px; line-height: 22px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; }
  .about__why span { display: block; font-size: 15px; line-height: 23px; }

  /* Lets grow together on white, logos on black, form on white */
  body:has(.ab-intro) .cta-band { background: #fff; border-top: 1px solid #eee; }
  body:has(.ab-intro) .cta-band__title { color: #000; }
  body:has(.ab-intro) .cta-band .btn--white { background: #000; color: #fff; }
  body:has(.ab-intro) .trusted { background: #000; }
  body:has(.ab-intro) .trusted__title { color: #fff; }
  body:has(.ab-intro) .logos__item img { filter: grayscale(1) invert(1) contrast(1.2); }
  body:has(.ab-intro) .contact-form { background: #fff; }

  @media (max-width: 1100px) {
    .about__why { grid-template-columns: 1fr; }
    .ab-miles { grid-template-columns: repeat(2, 1fr); row-gap: 40px; }
    .team__lead { grid-template-columns: 1fr 1fr; gap: 36px; }
    .team__lead img { width: 100%; height: auto; aspect-ratio: 1; }
    .ab-team .team__grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 767px) {
    .ab-title { font-size: 35px; line-height: 48px; }
    .ab-intro { grid-template-columns: 1fr; gap: 30px; padding: 40px 16px; }
    .ab-lead { font-size: 18px !important; line-height: 30px !important; }
    .ab-story { padding: 50px 16px; }
    .ab-story .ab-title { margin-bottom: 30px; }
    .ab-miles { grid-template-columns: 1fr; border-left: 1px solid #555; margin-left: 6px; margin-bottom: 40px; }
    .ab-miles li { border-top: 0; padding: 0 0 30px 26px; }
    .ab-miles li::before { left: -7px; top: 4px; }
    .ab-nums { grid-template-columns: repeat(2, 1fr); row-gap: 30px; padding-top: 40px; }
    .ab-nums b { font-size: 46px; letter-spacing: 2px; }
    .ab-nums span { font-size: 12px; letter-spacing: 1.5px; }
    .team { padding-left: 16px; padding-right: 16px; }
    .team--ceo { padding-top: 40px; padding-bottom: 20px; }
    .team__lead { grid-template-columns: 1fr; gap: 22px; }
    .team__bio { font-size: 16px; line-height: 27px; }
    .team__quote { font-size: 19px; line-height: 29px; }
    .ab-band { padding: 40px 16px; }
    .ab-team { padding: 40px 16px; }
    .ab-team .team__grid { grid-template-columns: repeat(2, 1fr); column-gap: 12px; }
  }
</style>
