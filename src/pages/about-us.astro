---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CtaBand from '../components/CtaBand.astro';
import Logos from '../components/Logos.astro';
import { logosInner } from '../data/site';
import '../styles/pages.css';
import hero from '../assets/site/hero-about.jpg';
import builder from '../assets/about/builder-back.jpg';

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/about/team-*.jpg', { eager: true });
const ph = (n: string) => photos[`../assets/about/team-${n}.jpg`].default;
// [photo key or '' if no photo yet, name, role] — 6 per row
const team = [
  ['alina', 'Alina D.', 'Business Development Manager'], ['vladimir', 'Vladimir H.', 'Project Manager'], ['kiranraj', 'Kiranraj', 'MEP Engineer'],
  ['alam', 'Alam', 'Site Foreman'], ['hema', 'Hema', 'Document Controller'], ['athira', 'Athira', 'Office Administrator'],
  ['gerin', 'Gerin K.', 'Designer'], ['thejus', 'Thejus T.', 'Designer'], ['sofia', 'Sofia', 'Designer'],
  ['saba', 'Saba F.', 'Procurement Designer'], ['dhanesh', 'Dhanesh T.', '3D Visualizer'], ['abishikth', 'Abishikth', 'Head of Accounts'],
];
const initials = (n: string) => n.replace(/\./g, '').split(' ').map((w) => w[0]).join('').slice(0, 2).toUpperCase();
// numbers from the owner (2026-11-12)
const facts: [string, string][] = [['200+', 'Projects completed'], ['38', 'Projects in Emaar properties'], ['58', 'Projects with Dubai Holding'], ['10', 'Projects in TECOM']];

// Our story: milestones
const story: [string, string, string][] = [
  ['Before 2014', 'The search', 'Konstantin Grytsan works around the world as a lead designer and architect — business parks and hotels in Berlin and Moscow, a private palace in Doha. Again and again he struggles to find builders who understand a designer’s idea, take real responsibility for the result and have an eye for beauty in the details.'],
  ['2014', 'Crystal Fit is founded', 'Konstantin opens Crystal Fit in Dubai as a design studio: concepts, 3D visualisation and technical drawings for cafes, offices and homes.'],
  ['Growth', 'From design to build', 'Clients ask us to build what we design. Step by step the studio grows into a full in-house fit-out team — project managers, MEP engineers, site foremen and our own builders.'],
  ['Today', 'One team, sketch to handover', '200+ completed projects for Roasters, WALA, Christie’s, Mercure and private clients, delivered under the requirements of Emaar, Dubai Holding and TECOM.'],
];

const schema = [{ '@type': 'AboutPage', name: 'About Crystal Fit Contracting LLC', url: new URL('/about-us/', Astro.site).href,
  mainEntity: { '@id': new URL('/#company', Astro.site).href } },
  { '@type': 'Person', name: 'Konstantin Grytsan', jobTitle: 'CEO & Founder', worksFor: { '@id': new URL('/#company', Astro.site).href }, alumniOf: 'Heriot-Watt University', sameAs: ['https://www.linkedin.com/in/konstantin-grytsan-1082a968/'] }];
---
<Base title="About Crystal Fit – Design & Build Fit-Out Team, Dubai" description="Dubai design & build fit-out team since 2014: 200+ projects for Roasters, Christie's, Mercure and Shangri-La. Approved by Emaar and Dubai Holding." schema={schema}>
  <Hero slides={[{ image: hero, lines: ['Who we', 'are'] }]} place="right-top" dark h1="— about Crystal Fit Contracting LLC, design & build fit-out company in Dubai" />

  <!-- 1. About us: same style as the CEO message, text left, picture right (white) -->
  <section class="team team--intro">
    <div class="team__lead team__lead--rev">
      <div class="team__bio">
        <p class="ab-kicker">About Crystal Fit</p>
        <p class="team__quote">Crystal Fit Contracting LLC is a Dubai-based design &amp; build studio operating across the GCC and MENA region since 2014.</p>
        <p>With over a decade of expertise in the local interior fit-out market, we provide a one-stop solution for clients in the Commercial, HoReCa (Hotels, Restaurants, Cafés), Residential, and Public sectors — delivering projects that prioritize time, quality, and a bespoke business approach.</p>
        <p>Our portfolio features 200+ successfully completed projects across Dubai, reflecting our ability to transform spaces into inspiring, functional, and brand-driven environments.</p>
        <p>At Crystal Fit, we are selective with our approaches, suppliers, and contractors to ensure the highest quality standards, making us a trusted partner for businesses and individuals alike.</p>
        <p class="ab-cta-line">Let’s elevate your spaces — enhancing both lifestyle and business success — with our professional design &amp; build services.</p>
      </div>
      <figure>
        <Image src={builder} alt="Crystal Fit builder pointing at the company logo on his T-shirt" width={487} height={487} widths={[487, 974]} sizes="(min-width: 768px) 487px, 100vw" fit="cover" position="top" loading="lazy" quality={75} />
      </figure>
    </div>
  </section>

  <!-- 2. Our story: milestones + key numbers (black) -->
  <section class="ab-story">
    <h2 class="ab-title">Our story</h2>
    <ol class="ab-miles">
      {story.map(([when, t, d]) => <li><span class="ab-miles__when">{when}</span><h3>{t}</h3><p>{d}</p></li>)}
    </ol>
    <div class="ab-nums">
      {facts.map(([n, t]) => <div><b>{n}</b><span>{t}</span></div>)}
    </div>
  </section>

  <!-- 3. Message from the CEO (white) -->
  <section class="team team--ceo">
    <div class="team__lead">
      <figure>
        <Image src={ph('konstantin')} alt="Konstantin Grytsan, CEO and founder of Crystal Fit" width={487} height={487} widths={[487, 974]} sizes="(min-width: 768px) 487px, 100vw" fit="cover" loading="lazy" />
        <figcaption><b>Konstantin Grytsan</b><span>CEO / Founder</span></figcaption>
      </figure>
      <div class="team__bio">
        <p class="ab-kicker">Message from the CEO</p>
        <p class="team__quote">“Design is a promise. Our job is to keep it — in every joint, every detail and every deadline.”</p>
        <p>Architect and project manager. Before Crystal Fit, Konstantin designed and led business parks, hotels and mixed-use towers in Berlin and Moscow and a 12,000 sqm private palace in Doha. In 2014 he founded Crystal Fit in Dubai — today a design &amp; build team with 200+ completed projects, from Roasters and WALA to Christie’s and Mercure Gold Hotel.</p>
        <ul class="team__mottos">
          <li>Beautiful is not enough — a space has to work for the business behind it.</li>
          <li>One team, one responsibility: from the first sketch to the last detail.</li>
          <li>We hand over only what we are proud to sign.</li>
        </ul>
        <p class="team__creds">Heriot-Watt University, Project Management · Certified ARCHICAD &amp; AutoCAD specialist · <a href="https://www.linkedin.com/in/konstantin-grytsan-1082a968/" target="_blank" rel="noopener">LinkedIn</a></p>
      </div>
    </div>
  </section>

  <!-- 4. Team behind the magic + team photos, 6 per row (black) -->
  <section class="ab-team">
    <h2 class="ab-title ab-team__title">Team behind the magic</h2>
    <div class="team__grid">
      {team.map(([k, n, r]) => (
        <figure>
          {k ? <Image src={ph(k)} alt={`${n}, ${r} at Crystal Fit`} width={254} height={254} widths={[254, 508]} sizes="(min-width: 1200px) 200px, (min-width: 768px) 30vw, 50vw" fit="cover" loading="lazy" />
             : <div class="team__ph" aria-hidden="true">{initials(n)}</div>}
          <figcaption><b>{n}</b><span>{r}</span></figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- 5. Trusted by the best (white), 6. Lets grow together (black), form (white), footer (black) -->
  <Logos list={logosInner} />
  <CtaBand title="LETS GROW TOGETHER" label="APPLY NOW" href="/contact/?topic=recruitment#contact-form" />
</Base>
<style is:global>
  /* About page: black / white sections only, alternating */
  .ab-title { font-family: var(--ff-head); font-size: var(--fs-h2); line-height: var(--lh-h2); font-weight: 200; letter-spacing: 0; text-transform: uppercase; margin: 0; }

  .ab-story { background: #000; color: #fff; padding: 80px 40px; font-family: var(--ff-head); }
  .ab-story > * { max-width: 1270px; margin-left: auto; margin-right: auto; }
  .ab-story .ab-title { margin-bottom: 50px; }
  .ab-miles { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 0; margin-bottom: 70px; }
  .ab-miles li { position: relative; padding: 34px 30px 0 0; border-top: 1px solid #555; }
  .ab-miles li::before { content: ''; position: absolute; left: 0; top: -7px; width: 13px; height: 13px; background: #fff; border-radius: 50%; }
  .ab-miles__when { font-family: var(--ff-head); font-size: var(--fs-label); line-height: var(--lh-label); font-weight: 700; letter-spacing: 2px; text-transform: uppercase; display: block; color: #fff; margin-bottom: 10px; }
  .ab-miles h3 { font-family: var(--ff-head); font-size: var(--fs-h3); line-height: var(--lh-h3); font-weight: 500; letter-spacing: 1px; text-transform: uppercase; margin: 0 0 12px; }
  .ab-miles p { font-family: var(--ff-head); font-size: var(--fs-body); line-height: var(--lh-body); font-weight: 300; letter-spacing: 0; color: #cfcfcf; margin: 0; }
  .ab-nums { display: grid; grid-template-columns: repeat(4, 1fr); text-align: center; gap: 20px; padding-top: 10px; }
  .ab-nums b { font-family: var(--ff-head); font-size: calc(var(--fs-stat) * .78); line-height: 1.15; font-weight: 700; letter-spacing: 1px; font-variant-numeric: lining-nums; display: block; margin-bottom: 8px; } /* slightly smaller than home stats */
  .ab-nums span { font-family: var(--ff-head); font-size: var(--fs-body); line-height: var(--lh-body); font-weight: 400; letter-spacing: 0; text-transform: none; display: block; color: #ddd; }

  .team { max-width: 1350px; margin: 0 auto; padding-left: 40px; padding-right: 40px; }
  .team--intro { padding-top: 80px; padding-bottom: 80px; }
  .team--intro .team__quote { font-style: normal; }
  .ab-cta-line { font-weight: 500; color: #000; }
  .team__lead.team__lead--rev { grid-template-columns: 1fr 487px; }
  .team--ceo { background: #fff; padding-top: 80px; padding-bottom: 80px; }
  .team__lead { display: grid; grid-template-columns: 487px 1fr; gap: 60px; align-items: center; }
  .team__lead figure { margin: 0; }
  .team__lead img { width: 487px; height: 487px; object-fit: cover; display: block; }
  .team__lead figcaption { padding-top: 16px; color: #000; font-family: var(--ff-head); text-transform: uppercase; }
  .team__lead figcaption b { font-family: var(--ff-head); font-size: var(--fs-card); line-height: var(--lh-card); font-weight: 600; letter-spacing: 1px; text-transform: uppercase; display: block; }
  .team__lead figcaption span { font-size: var(--fs-cap); line-height: var(--lh-cap); display: block; color: #555; }
  .team__bio { font-family: var(--ff-head); font-size: var(--fs-body); line-height: var(--lh-body); font-weight: 300; letter-spacing: 0; color: #333; max-width: 640px; }
  .team__bio p { margin: 0 0 16px; }
  .ab-kicker { font-family: var(--ff-head); font-size: var(--fs-label); line-height: var(--lh-label); font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: #000; margin-bottom: 18px !important; }
  .team__quote { font-family: var(--ff-head); font-size: var(--fs-lead); line-height: var(--lh-lead); font-weight: 400; letter-spacing: 0; font-style: italic; color: #000; border-left: 2px solid #000; padding-left: 20px; margin-bottom: 26px !important; }
  .team__mottos { list-style: none; margin: 0 0 18px; padding: 0; }
  .team__mottos li { position: relative; padding-left: 18px; margin-bottom: 8px; font-weight: 500; color: #000; }
  .team__mottos li::before { content: ''; position: absolute; left: 0; top: 12px; width: 7px; height: 7px; background: #000; }
  .team__creds { font-size: var(--fs-cap); line-height: var(--lh-cap); text-transform: uppercase; color: #777; }
  .team__creds a { color: #000; text-decoration: underline; }

  .ab-team { background: #000; color: #fff; padding: 70px 40px 80px; }
  .ab-team__title { text-align: center; margin: 0 0 50px; }
  /* form under the black CTA band: white */
  body:has(.ab-team) .contact-form { background: #fff; }
  .ab-team .team__grid { max-width: 1270px; margin: 0 auto; display: grid; grid-template-columns: repeat(6, 1fr); column-gap: 20px; row-gap: 30px; padding: 0; }
  .ab-team figure { margin: 0; }
  .ab-team img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; display: block; }
  .ab-team figcaption { padding-top: 14px; color: #fff; font-family: var(--ff-head); text-transform: uppercase; }
  .ab-team figcaption b { font-family: var(--ff-head); font-size: var(--fs-card); line-height: var(--lh-card); font-weight: 600; letter-spacing: 1px; text-transform: uppercase; display: block; }
  .ab-team figcaption span { font-size: var(--fs-cap); line-height: var(--lh-cap); display: block; color: #aaa; }
  .team__ph { aspect-ratio: 1; background: #1c1c1c; display: flex; align-items: center; justify-content: center; font-family: var(--ff-head); font-size: 40px; font-weight: 200; letter-spacing: 3px; color: #666; }



  @media (max-width: 1100px) {
    .ab-miles { grid-template-columns: repeat(2, 1fr); row-gap: 40px; }
    .team__lead, .team__lead.team__lead--rev { grid-template-columns: 1fr 1fr; gap: 36px; }
    .team__lead img { width: 100%; height: auto; aspect-ratio: 1; }
    .ab-team .team__grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 767px) {

    .ab-story { padding: 50px 16px; }
    .ab-story .ab-title { margin-bottom: 30px; }
    .ab-miles { grid-template-columns: 1fr; border-left: 1px solid #555; margin-left: 6px; margin-bottom: 40px; }
    .ab-miles li { border-top: 0; padding: 0 0 30px 26px; }
    .ab-miles li::before { left: -7px; top: 4px; }
    .ab-nums { grid-template-columns: repeat(2, 1fr); row-gap: 30px; padding-top: 0; }


    .team { padding-left: 16px; padding-right: 16px; }
    .team--ceo { padding-top: 40px; padding-bottom: 40px; }
    .team__lead, .team__lead.team__lead--rev { grid-template-columns: 1fr; gap: 22px; }
    .team__lead--rev figure { order: -1; }
    .team--intro { padding-top: 40px; padding-bottom: 40px; }
    .ab-team__title { margin-bottom: 30px; }


    .ab-team { padding: 40px 16px; }
    .ab-team .team__grid { grid-template-columns: repeat(2, 1fr); column-gap: 12px; }
  }
</style>
