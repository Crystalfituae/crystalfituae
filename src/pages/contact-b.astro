---
// DRAFT B: split screen — contacts left, tall map right (noindex, not in sitemap)
import Base from '../layouts/Base.astro';
import LineIcon from '../components/LineIcon.astro';
import Icon from '../components/Icon.astro';
import Logos from '../components/Logos.astro';
import { logosInner, site } from '../data/site';
import '../styles/pages.css';
const follow = site.socials.map((s) => [s.name === 'linkedin-in' ? 'linkedin' : s.name, s.href]);
---
<Base title="Contact Crystal Fit – draft B" noindex>
  <section class="cb">
    <div class="cb__info">
      <h1>Get in touch</h1>
      <p class="cb__intro">Planning a cafe, restaurant, office or villa in Dubai? Talk to our design &amp; build team — we will advise on design, approvals and the next step.</p>
      <ul class="cb__list">
        <li><LineIcon name="pin" size={22} /><div><b>Office &amp; workshop</b><span>Al Quoz Industrial 3, Ghoshi Warehouse City WH-132, Dubai</span></div></li>
        <li><LineIcon name="phone" size={22} /><div><b>Call</b><a href={`tel:${site.phoneOffice}`}>+971 4 320 2224</a></div></li>
        <li><LineIcon name="chat" size={22} /><div><b>WhatsApp</b><a href={site.whatsapp} target="_blank" rel="noopener">{site.phoneMobileDisplay}</a></div></li>
        <li><LineIcon name="mail" size={22} /><div><b>Email</b><a href={`mailto:${site.email}`}>{site.email}</a></div></li>
        <li><LineIcon name="clock" size={22} /><div><b>Working hours</b><span>Mon – Sat: 09:00 – 18:00 · Sunday: closed</span></div></li>
      </ul>
      <ul class="cb__social">{follow.map(([n, h]) => <li><a href={h} target="_blank" rel="noopener" aria-label={n}><Icon name={n} size={17} /></a></li>)}</ul>
    </div>
    <div class="cb__map">
      <iframe title="Crystal Fit Contracting LLC on Google Maps" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src={site.mapEmbed}></iframe>
      <a class="cb__btn" href={site.mapUrl} target="_blank" rel="noopener"><LineIcon name="pin" size={16} /> Get directions</a>
    </div>
  </section>
  <Logos list={logosInner} />
</Base>
<style is:global>
  .cb { display: grid; grid-template-columns: 1fr 1fr; min-height: 640px; }
  .cb__info { padding: 80px 60px; font-family: var(--ff-head); }
  .cb h1 { font-size: 40px; line-height: 44px; font-weight: 900; text-transform: uppercase; color: var(--dark); margin: 0 0 18px; }
  .cb__intro { font-size: 17px; line-height: 28px; font-weight: 300; color: #333; max-width: 520px; margin: 0 0 36px; }
  .cb__list { list-style: none; margin: 0; padding: 0; }
  .cb__list li { display: flex; gap: 16px; align-items: flex-start; padding: 16px 0; border-top: 1px solid #e6e6e6; }
  .cb__list li:last-child { border-bottom: 1px solid #e6e6e6; }
  .cb__list svg { flex: 0 0 auto; margin-top: 2px; }
  .cb__list b { display: block; font-size: 13px; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 3px; }
  .cb__list span, .cb__list a { font-size: 16px; line-height: 25px; font-weight: 300; color: #333; }
  .cb__list a:hover { text-decoration: underline; }
  .cb__social { list-style: none; padding: 0; margin: 28px 0 0; display: flex; gap: 10px; }
  .cb__social a { display: flex; width: 40px; height: 40px; align-items: center; justify-content: center; border: 1px solid #222; border-radius: 50%; color: #000; }
  .cb__social a:hover { background: #000; color: #fff; }
  .cb__map { position: relative; background: #e9e9e9; }
  .cb__map iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .cb__btn { position: absolute; left: 24px; bottom: 24px; display: inline-flex; align-items: center; gap: 8px; background: #000; color: #fff; padding: 14px 24px; font-family: var(--ff-head); font-size: 13px; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; box-shadow: 0 6px 20px rgba(0,0,0,.25); }
  @media (max-width: 900px) {
    .cb { grid-template-columns: 1fr; }
    .cb__info { padding: 40px 16px; }
    .cb h1 { font-size: 30px; line-height: 34px; }
    .cb__map { height: 380px; }
  }
</style>
