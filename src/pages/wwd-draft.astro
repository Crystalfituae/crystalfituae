---
// DRAFT (noindex, not in sitemap): 3 compact variants of the home "What we do" block
import Base from '../layouts/Base.astro';
import LineIcon from '../components/LineIcon.astro';

const items: [string, string, string, string][] = [
  ['F&B Design & Build', 'Cafes, coffee shops & restaurants', '/cafe-restaurant-fit-out-dubai/', 'chat'],
  ['Commercial Fit-outs', 'Offices, clinics, retail & galleries', '/commercial-fit-out-dubai/', 'layers'],
  ['Residential Interiors', 'Villas, townhouses & apartments', '/villa-interior-design-dubai/', 'pin'],
  ['Design and Technical Consultancy', 'Concepts, drawings & approvals', '/interior-design-consultancy-dubai/', 'pen'],
  ['Project Management', 'Programme, budget & quality on site', '/contact/', 'clipboard'],
];
---
<Base title="What we do – drafts" noindex form={false}>
  <!-- A: buttons -->
  <section class="wd" id="a">
    <p class="wd__tag">Variant A — buttons</p>
    <h2 class="wd__h2">What we do<span class="wd__dot"></span></h2>
    <div class="wd-a">
      {items.map(([t, , href]) => <a href={href}>{t}<span>→</span></a>)}
    </div>
  </section>

  <!-- B: clickable list -->
  <section class="wd" id="b">
    <p class="wd__tag">Variant B — clickable list</p>
    <h2 class="wd__h2">What we do<span class="wd__dot"></span></h2>
    <ol class="wd-b">
      {items.map(([t, d, href], i) => <li><a href={href}><em>0{i + 1}</em><b>{t}</b><span>{d}</span><i>→</i></a></li>)}
    </ol>
  </section>

  <!-- C: icon tiles -->
  <section class="wd" id="c">
    <p class="wd__tag">Variant C — icon tiles</p>
    <h2 class="wd__h2">What we do<span class="wd__dot"></span></h2>
    <div class="wd-c">
      {items.map(([t, d, href, ico]) => <a href={href}><LineIcon name={ico} size={34} stroke={1.3} /><b>{t}</b><span>{d}</span><i>→</i></a>)}
    </div>
  </section>
</Base>
<style is:global>
  .wd { background: #000; color: #fff; padding: 60px 40px 70px; font-family: var(--ff-head); border-bottom: 6px solid #fff; }
  .wd > * { max-width: 1360px; margin-left: auto; margin-right: auto; }
  .wd__tag { font-size: 12px; letter-spacing: 3px; text-transform: uppercase; color: #888; margin-bottom: 10px; }
  .wd__h2 { font-size: 43px; line-height: 60px; font-weight: 400; text-transform: uppercase; margin-top: 0; margin-bottom: 34px; }
  .wd__dot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; background: #fff; margin-left: 12px; vertical-align: middle; }

  /* A: outlined buttons in one row */
  .wd-a { display: flex; flex-wrap: wrap; gap: 14px; }
  .wd-a a { flex: 1 1 0; min-width: 200px; display: flex; justify-content: space-between; align-items: center; gap: 12px; border: 1px solid #fff; padding: 18px 20px; font-size: 15px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; color: #fff; transition: background .2s, color .2s; }
  .wd-a a:hover { background: #fff; color: #000; }

  /* B: numbered list rows */
  .wd-b { list-style: none; padding: 0; margin-top: 0; margin-bottom: 0; border-top: 1px solid #333; }
  .wd-b a { display: grid; grid-template-columns: 60px 1fr 1fr 30px; align-items: center; gap: 20px; padding: 20px 4px; border-bottom: 1px solid #333; color: #fff; transition: padding .2s, background .2s; }
  .wd-b a:hover { background: #111; padding-left: 14px; }
  .wd-b em { font-style: normal; font-size: 14px; color: #777; letter-spacing: 2px; }
  .wd-b b { font-size: 20px; font-weight: 500; text-transform: uppercase; letter-spacing: 1px; }
  .wd-b span { font-size: 16px; font-weight: 300; color: #bbb; }
  .wd-b i { font-style: normal; font-size: 20px; text-align: right; }

  /* C: compact icon tiles, one row */
  .wd-c { display: grid; grid-template-columns: repeat(5, 1fr); gap: 14px; }
  .wd-c a { display: flex; flex-direction: column; gap: 10px; border: 1px solid #333; background: #0d0d0d; padding: 22px 20px; color: #fff; transition: border-color .2s; }
  .wd-c a:hover { border-color: #fff; }
  .wd-c b { font-size: 15px; line-height: 21px; font-weight: 600; letter-spacing: .8px; text-transform: uppercase; min-height: 42px; }
  .wd-c span { font-size: 14px; line-height: 21px; font-weight: 300; color: #bbb; flex: 1; }
  .wd-c i { font-style: normal; font-size: 18px; }

  @media (max-width: 991px) {
    .wd { padding: 40px 16px 50px; }
    .wd__h2 { font-size: 30px; line-height: 40px; margin-bottom: 24px; }
    .wd-a a { flex-basis: 100%; }
    .wd-b a { grid-template-columns: 36px 1fr 24px; gap: 4px 12px; }
    .wd-b span { grid-column: 2; grid-row: 2; font-size: 14px; }
    .wd-b b { font-size: 16px; }
    .wd-b i { grid-column: 3; grid-row: 1 / span 2; }
    .wd-c { grid-template-columns: 1fr 1fr; }
    .wd-c b { min-height: 0; }
  }
</style>
