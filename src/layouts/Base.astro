---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import Schema from '../components/Schema.astro';
import Tracking from '../components/Tracking.astro';
interface Props { title: string; description?: string; image?: string; form?: boolean; minimalFooter?: boolean; noindex?: boolean; schema?: object[] }
const { title, description = '', image, form = true, minimalFooter = false, noindex = false, schema = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// default share preview: a project photo (public/og-default.jpg, 1200x630), not the square logo
const og = new URL(image ?? '/og-default.jpg', Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Crystal Fit" />
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={og} />
  {!image && <><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /></>}
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" />
  <link rel="icon" href="/favicon-192.png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preload" href="/fonts/poppins-300.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/raleway-200-900.woff2" as="font" type="font/woff2" crossorigin />
  <Schema extra={schema} />
  <slot name="head" />
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  {form && <ContactForm />}
  <slot name="after-form" />
  <Footer minimal={minimalFooter} />
  <Tracking />
</body>
</html>
