---
import Icon from './Icon.astro';
import { site } from '../data/site';
const { minimal = false } = Astro.props;
---
<footer class="site-footer">
  {!minimal && (
    <div class="site-footer__top">
      <div class="site-footer__col">
        <h6>Contact</h6>
        <ul class="site-footer__contact">
          <li><a href={`tel:${site.phoneMobile}`} rel="nofollow"><Icon name="phone" size={12} />{site.phoneMobileDisplay}</a></li>
          <li><a href={`mailto:${site.email}`} rel="nofollow"><Icon name="comment" size={12} />{site.email}</a></li>
          <li><a href={site.mapUrl} target="_blank" rel="nofollow noopener"><Icon name="map-pin" size={12} />{site.address}</a></li>
        </ul>
      </div>
      <div class="site-footer__col">
        <h6>Quick Menu</h6>
        <ul class="site-footer__menu">
          <li><a href="/about-us/"><Icon name="user" size={13} />ABOUT US</a></li>
          <li><a href="/portfolio/"><Icon name="bookmark" size={13} />OUR DESIGNS</a></li>
          <li><a href="/contact/"><Icon name="paper-plane" size={13} />CONTACT US</a></li>
        </ul>
      </div>
    </div>
  )}
  <div class="site-footer__bottom">
    <p>Crystal fit contracting LLC. All rights reserved</p>
    <ul class="socials">
      {site.socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener" aria-label={s.name}><Icon name={s.name} /></a></li>)}
    </ul>
  </div>
</footer>
<a class="wa-fab" href={site.whatsapp} target="_blank" rel="noopener" aria-label="Chat on WhatsApp"><Icon name="whatsapp" size={32} /></a>
