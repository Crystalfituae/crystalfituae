---
import Icon from './Icon.astro';
import { site } from '../data/site';
const { minimal = false } = Astro.props;
---
<footer class="site-footer">
  {!minimal && (
    <div class="site-footer__top">
      <div class="site-footer__col">
        <h6>Contact</h6>
        <ul class="site-footer__contact">
          <li><a href={`tel:${site.phoneMobile}`} rel="nofollow"><Icon name="phone" size={12} />{site.phoneMobileDisplay}</a></li>
          <li><a href={`mailto:${site.email}`} rel="nofollow"><Icon name="comment" size={12} />{site.email}</a></li>
          <li><a href={site.mapUrl} target="_blank" rel="nofollow noopener"><Icon name="map-pin" size={12} />{site.address}</a></li>
        </ul>
      </div>
      <div class="site-footer__col">
        <h6>Quick Menu</h6>
        <ul class="site-footer__menu">
          <li><a href="/about-us/"><Icon name="user" size={13} />ABOUT US</a></li>
          <li><a href="/portfolio/"><Icon name="bookmark" size={13} />OUR DESIGNS</a></li>
          <li><a href="/contact/"><Icon name="paper-plane" size={13} />CONTACT US</a></li>
        </ul>
      </div>
    </div>
  )}
  <div class="site-footer__bottom">
    <p>Crystal fit contracting LLC. All rights reserved</p>
    <ul class="site-footer__legal">
      <li><a href="/privacy-policy/">Privacy Policy</a></li>
      <li><a href="/terms/">Terms of Use</a></li>
    </ul>
    <ul class="socials">
      {site.socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener" aria-label={s.name}><Icon name={s.name} /></a></li>)}
    </ul>
  </div>
</footer>
<button class="to-top" type="button" aria-label="Back to top" hidden><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg></button>
<script is:inline>
(function () {
  var b = document.querySelector('.to-top'); if (!b) return;
  var on = false;
  function upd() { var v = scrollY > 700; if (v !== on) { on = v; b.hidden = false; b.classList.toggle('is-on', v); } }
  addEventListener('scroll', upd, { passive: true }); upd();
  b.addEventListener('click', function () { scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' }); });
})();
</script>
<a class="wa-fab" href={site.whatsapp} target="_blank" rel="noopener" aria-label="Chat on WhatsApp"><Icon name="whatsapp" size={32} /></a>
