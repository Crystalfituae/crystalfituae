---
import Base from '../layouts/Base.astro';
interface Props { title: string; heading: string; description: string; updated: string }
const { title, heading, description, updated } = Astro.props;
---
<Base title={title} description={description} form={false}>
  <article class="legal">
    <h1>{heading}</h1>
    <p class="legal__updated">Last updated: {updated}</p>
    <slot />
  </article>
</Base>
<style is:global>
  .legal { max-width: 820px; margin: 0 auto; padding: 70px 20px 90px; font-size: 15px; line-height: 1.75; color: var(--ink); }
  .legal h1 { font-family: var(--ff-head); font-size: 40px; line-height: 1.2; font-weight: 600; letter-spacing: 3px; text-transform: uppercase; margin: 0 0 10px; }
  .legal h2 { font-family: var(--ff-head); font-size: 20px; line-height: 1.4; font-weight: 600; letter-spacing: 1px; margin: 40px 0 12px; }
  .legal p, .legal ul { margin: 0 0 14px; }
  .legal ul { padding-left: 22px; }
  .legal li { margin-bottom: 6px; }
  .legal a { text-decoration: underline; }
  .legal__updated { color: #777; font-size: 13px; margin-bottom: 30px !important; }
  @media (max-width: 767px) { .legal { padding: 40px 16px 60px; } .legal h1 { font-size: 28px; letter-spacing: 2px; } }
</style>
