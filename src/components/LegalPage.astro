---
import Base from '../layouts/Base.astro';
interface Props { title: string; heading: string; description: string; updated: string }
const { title, heading, description, updated } = Astro.props;
---
<Base title={title} description={description} form={false}>
  <article class="legal">
    <h1>{heading}</h1>
    <p class="legal__updated">Last updated: {updated}</p>
    <slot />
  </article>
</Base>
<style is:global>
  .legal { font-family: var(--ff-head); font-size: var(--fs-body); line-height: var(--lh-body); font-weight: 300; letter-spacing: 0; max-width: 820px; margin: 0 auto; padding: 70px 20px 90px; color: var(--ink); }
  .legal h1 { font-family: var(--ff-head); font-size: var(--fs-h2); line-height: var(--lh-h2); font-weight: 200; letter-spacing: 0; text-transform: uppercase; margin: 0 0 10px; }
  .legal h2 { font-family: var(--ff-head); font-size: var(--fs-h3); line-height: var(--lh-h3); font-weight: 500; letter-spacing: 1px; text-transform: uppercase; margin: 40px 0 12px; }
  .legal p, .legal ul { margin: 0 0 14px; }
  .legal ul { padding-left: 22px; }
  .legal li { margin-bottom: 6px; }
  .legal a { text-decoration: underline; }
  .legal__updated { font-size: var(--fs-cap); line-height: var(--lh-cap); color: #777; margin-bottom: 30px !important; }
  @media (max-width: 767px) { .legal { padding: 40px 16px 60px; } }
</style>
