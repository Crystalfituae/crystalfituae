---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
const all = import.meta.glob<{ default: ImageMetadata }>('../assets/logos/*', { eager: true });
const byName = (n: string) => Object.entries(all).find(([k]) => k.endsWith('/' + n))?.[1].default;
const { list, title = true } = Astro.props;
const names: Record<string, string> = {
  'dub-gov-300.png': 'Government of Dubai', 'emaar-logo-1.png': 'Emaar', 'aw-dh-pv-pos-rgb-en-002.png': 'Dubai Holding', 'tecom-group.png': 'TECOM Group',
  'nakheel-properties-logo-2.png': 'Nakheel', '1621791093880-1.png': 'IDAMA Facilities Management', 'vindico.png': 'Vindico', 'dubai-police-300.png': 'Dubai Police',
  'trakhees.png': 'Trakhees', 'roasters-png.png': 'Roasters Specialty Coffee', 'brew-png.png': 'Title Brew Specialty Coffee', 'yoy-2.png': 'YOY Restaurant',
  'christie-s-logo-7b51158dc3-seeklogo-com-.png': "Christie's", 'logo-black.png': 'In the Pink', 'the-game-logo-1.png': 'The Game Premium Lounge',
  '118507871-400x300-1.png': 'Three Diamonds Real Estate', 'muha-logo-bw-1.png': 'Muha Music & Fine Arts', 'muha.png': 'Muha Music & Fine Arts', 'narrow-300.png': 'Narrow Specialty Coffee',
  'fissman-logo-1.png': 'Fissman', 'paper-logo-1.png': 'Studio Paper', 'desires-logo.png': "Desire's Specialty Coffee", 'download-1.png': 'The Cake Bar',
  'mercure-150.png': 'Mercure Gold Hotel', 'osha150.png': 'Osha', 'livrichy.png': 'Livrichy Real Estate', 'wala.png': 'Wala Coffee & Roastery', 'panmi.png': 'Panmi Milk Toast Cafe', 'amv.png': 'AMV Clinic', 'gasteria.png': 'Gasteria', 'tatintsian.png': 'Gary Tatintsian Gallery', 'selfspace.png': 'self.space', 'hanah.png': 'Hanah Chocolate', 'img-2642.png': 'Friends Avenue Cafe',
};
const logos = (list as string[]).map((n) => ({ img: byName(n), alt: `${names[n] ?? 'Client'} logo` })).filter((l) => l.img) as { img: ImageMetadata; alt: string }[];
---
<section class="trusted">
  {title && <div class="trusted__title">trusted by the best</div>}
  <div class="logos">
    <ul class="logos__track">
      {[...logos, ...logos].map((l, i) => <li class="logos__item" aria-hidden={i >= logos.length ? 'true' : undefined}><Image src={l.img} alt={i >= logos.length ? '' : l.alt} widths={[150, 300]} sizes="150px" loading="lazy" /></li>)}
    </ul>
  </div>
</section>
