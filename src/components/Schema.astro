---
// schema.org structured data. The company block is on every page; pages add their own via `extra`.
import { site } from '../data/site';
interface Props { extra?: object[] }
const { extra = [] } = Astro.props;
const base = site.url;
const org = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  '@id': `${base}/#company`,
  name: site.name,
  alternateName: 'Crystal Fit',
  url: `${base}/`,
  logo: `${base}/favicon-192.png`,
  image: `${base}/og-default.jpg`,
  description: 'Design & build fit-out contractor in Dubai since 2014. 200+ completed projects: specialty coffee shops, restaurants, offices, retail, clinics, galleries and villas. Works with major landlords and authorities: Emaar, Dubai Holding, TECOM, Nakheel, Dubai Municipality, Civil Defence, DEWA, Trakhees.',
  slogan: 'One stop design & build team',
  telephone: site.phoneMobile,
  email: site.email,
  foundingDate: site.foundingYear,
  address: { '@type': 'PostalAddress', streetAddress: site.streetAddress, addressLocality: 'Dubai', addressCountry: 'AE' },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  hasMap: site.mapUrl,
  areaServed: [{ '@type': 'Country', name: 'United Arab Emirates' }],
  knowsAbout: ['Fit-out', 'Commercial fit-out', 'Design and build', 'Restaurant fit-out', 'Cafe fit-out', 'Office fit-out', 'Retail fit-out', 'Clinic fit-out', 'Villa interior design', 'Interior design', 'MEP design', 'Turnkey project management'],
  makesOffer: [
    ['Restaurant & café fit-out', 'Food & Beverage (F&B) design and build in Dubai: restaurants, cafés and coffee shops, with landlord, Dubai Municipality food safety, Civil Defence and DEWA approvals.'],
    ['Commercial, office & retail fit-out', 'Fit-out of offices, retail stores, clinics, galleries, studios and hotels in Dubai, including landlord and authority permits, MEP and custom joinery.'],
    ['Villa & apartment interior design and renovation', 'Interior design, renovation and fit-out of villas, townhouses, penthouses and apartments in Dubai.'],
    ['Interior & MEP design', 'Interior design drawings and MEP engineering with HVAC, electrical, plumbing, drainage and fire-fighting calculations; submission drawings for Dubai Municipality, Civil Defence and DEWA.'],
    ['Turnkey fit-out & project management', 'Programme, approvals and inspections, procurement, contractor coordination, quality, budget control and handover.'],
  ].map(([name, description]) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name, description, areaServed: 'Dubai, UAE' } })),
  sameAs: [...site.socials.filter((s) => s.name !== 'whatsapp').map((s) => s.href), ...site.sameAsExtra],
};
const json = (o: object) => JSON.stringify(o).replace(/</g, '\\u003c');
---
<script type="application/ld+json" set:html={json(org)} />
{extra.map((o) => <script type="application/ld+json" set:html={json({ '@context': 'https://schema.org', ...o })} />)}
