---
// Google Analytics 4 / Google Ads / Meta Pixel with a cookie-consent banner.
// Nothing is rendered until at least one ID is set in src/data/site.ts (or the PUBLIC_* env vars).
// Google tags load in Consent Mode v2 ("denied" until the visitor accepts); the Meta Pixel loads only after consent.
// Conversions: form sent (generate_lead / Lead), click on phone, WhatsApp or e-mail (contact / Contact).
import { site } from '../data/site';
const cfg = { ga: site.gaId, ads: site.adsId, adsLead: site.adsLeadLabel, pixel: site.metaPixelId };
const enabled = !!(cfg.ga || cfg.ads || cfg.pixel);
---
{enabled && (
  <>
    <div class="consent" id="consent" hidden role="dialog" aria-live="polite" aria-label="Cookie consent">
      <p>We use cookies to measure visits and improve our ads. See our <a href="/privacy-policy/#cookies">Privacy Policy</a>.</p>
      <div class="consent__btns">
        <button type="button" data-consent="denied">Decline</button>
        <button type="button" data-consent="granted" class="is-primary">Accept</button>
      </div>
    </div>
    <script is:inline define:vars={{ cfg }}>
      (function () {
        var KEY = 'cf-consent', w = window, d = document, stored = null;
        try { stored = localStorage.getItem(KEY); } catch (e) {}
        w.dataLayer = w.dataLayer || [];
        w.gtag = function () { w.dataLayer.push(arguments); };
        var g = stored === 'granted' ? 'granted' : 'denied';
        gtag('consent', 'default', { ad_storage: g, analytics_storage: g, ad_user_data: g, ad_personalization: g, wait_for_update: 500 });
        gtag('js', new Date());
        if (cfg.ga) gtag('config', cfg.ga);
        if (cfg.ads) gtag('config', cfg.ads);
        function load(src) { var s = d.createElement('script'); s.async = true; s.src = src; d.head.appendChild(s); }
        function pixel() {
          if (!cfg.pixel || w.fbq) return;
          var n = w.fbq = function () { n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments); };
          w._fbq = n; n.push = n; n.loaded = true; n.version = '2.0'; n.queue = [];
          load('https://connect.facebook.net/en_US/fbevents.js');
          fbq('init', cfg.pixel); fbq('track', 'PageView');
        }
        // load after the page is shown so tracking never slows down the first paint
        function start() {
          if (cfg.ga || cfg.ads) load('https://www.googletagmanager.com/gtag/js?id=' + (cfg.ga || cfg.ads));
          if (stored === 'granted') pixel();
        }
        if (d.readyState === 'complete') start(); else w.addEventListener('load', function () { setTimeout(start, 0); });

        var box = d.getElementById('consent');
        if (!stored) box.hidden = false;
        box.addEventListener('click', function (e) {
          var v = e.target.getAttribute && e.target.getAttribute('data-consent');
          if (!v) return;
          try { localStorage.setItem(KEY, v); } catch (err) {}
          stored = v; box.hidden = true;
          gtag('consent', 'update', { ad_storage: v, analytics_storage: v, ad_user_data: v, ad_personalization: v });
          if (v === 'granted') pixel();
        });

        // conversion helpers used by the contact form and link clicks
        w.cfTrack = function (kind, data) {
          data = data || {};
          if (kind === 'lead') {
            gtag('event', 'generate_lead', data);
            if (cfg.ads && cfg.adsLead) gtag('event', 'conversion', { send_to: cfg.ads + '/' + cfg.adsLead });
            if (w.fbq) fbq('track', 'Lead', data);
          } else {
            gtag('event', 'contact', { method: kind });
            if (w.fbq) fbq('track', 'Contact', { method: kind });
          }
        };
        d.addEventListener('click', function (e) {
          var a = e.target.closest && e.target.closest('a[href]');
          if (!a) return;
          var h = a.getAttribute('href');
          if (/^tel:/.test(h)) cfTrack('phone');
          else if (/wa\.me|whatsapp/.test(h)) cfTrack('whatsapp');
          else if (/^mailto:/.test(h)) cfTrack('email');
        });
      })();
    </script>
  </>
)}
<style>
  .consent { position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 1000; max-width: 560px; margin: 0 auto;
    display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; padding: 16px 20px;
    background: #fff; color: #222; box-shadow: 0 4px 24px rgba(0,0,0,.18); font-size: 13px; line-height: 1.5; }
  .consent[hidden] { display: none; }
  .consent p { margin: 0; flex: 1 1 260px; }
  .consent a { text-decoration: underline; }
  .consent__btns { display: flex; gap: 8px; }
  .consent button { font: inherit; font-weight: 500; padding: 8px 18px; border: 1px solid #000; background: #fff; color: #000; cursor: pointer; }
  .consent button.is-primary { background: var(--dark); color: #fff; }
</style>
