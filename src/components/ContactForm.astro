---
import { site } from '../data/site';
---
<section class="contact-form" id="contact-form">
  <div class="contact-form__inner">
    <p class="contact-form__label">Contact Us</p>
    <h5 class="contact-form__title">Let’s Talk Together</h5>
    <form class="cf" action="https://api.web3forms.com/submit" method="POST" data-cf>
      <input type="hidden" name="access_key" value={site.formKey} />
      <input type="hidden" name="from_name" value="crystalfituae.com" />
      <input type="hidden" name="subject" value="" />
      <input type="hidden" name="page" value="" />
      <input type="checkbox" name="botcheck" class="cf__hp" tabindex="-1" autocomplete="off" />
      <div class="cf__left">
        <input type="text" name="name" placeholder="First Name (required)" required maxlength="400" aria-label="First name" />
        <input type="email" name="email" placeholder="E-Mail (required)" required maxlength="400" aria-label="E-mail" />
        <input type="tel" name="phone" placeholder="Phone (required)" required maxlength="40" aria-label="Phone" />
        <select name="topic" aria-label="Enquiry type" required>
          <option value="Project Inquiry" selected>Project Inquiry</option>
          <option value="Collaborations">Collaborations</option>
          <option value="Recruitment">Recruitment</option>
        </select>
      </div>
      <div class="cf__right">
        <textarea name="message" placeholder="Message (required)" required maxlength="2000" aria-label="Message"></textarea>
        <button type="submit">Send</button>
      </div>
      <p class="cf__status" role="status" hidden></p>
      <p class="cf__legal">By sending this form you agree to our <a href="/privacy-policy/">Privacy Policy</a>.</p>
    </form>
  </div>
</section>
<script>
  // Every enquiry goes to info@ (the only recipient Web3Forms Free allows). "Project Inquiry" reaches kg@
  // through a Gmail filter on info@ (subject contains "Project Inquiry" -> forward to kg@).
  const send = (f: HTMLFormElement) =>
    fetch(f.action, { method: 'POST', headers: { Accept: 'application/json' }, body: new FormData(f) }).then((r) => r.json());
  // "Apply now" links to /contact/?topic=recruitment#contact-form — preselect the topic
  const wanted = new URLSearchParams(location.search).get('topic');
  for (const f of document.querySelectorAll<HTMLFormElement>('form[data-cf]')) {
    if (wanted) {
      const sel = f.elements.namedItem('topic') as HTMLSelectElement;
      const opt = [...sel.options].find((o) => o.value.toLowerCase() === wanted.toLowerCase());
      if (opt) { sel.value = opt.value; if (opt.value === 'Recruitment') (f.elements.namedItem('message') as HTMLTextAreaElement).placeholder = 'Tell us about yourself, the position you are interested in and a link to your CV / portfolio (required)'; }
    }
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const st = f.querySelector<HTMLElement>('.cf__status')!;
      const btn = f.querySelector('button')!;
      const topic = (f.elements.namedItem('topic') as HTMLSelectElement).value;
      (f.elements.namedItem('subject') as HTMLInputElement).value = `${topic} — crystalfituae.com`;
      (f.elements.namedItem('page') as HTMLInputElement).value = location.href;
      btn.disabled = true; st.hidden = false; st.textContent = 'Sending…';
      try {
        const main = await send(f);
        if (!main.success) throw new Error(main.message);
        st.textContent = 'Thank you for your message. It has been sent.';
        if (topic !== 'Recruitment') (window as any).cfTrack?.('lead', { topic });
        f.reset();
      } catch {
        st.textContent = 'There was an error trying to send your message. Please try again later.';
      } finally { btn.disabled = false; }
    });
  }
</script>
